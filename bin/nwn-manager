#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "[nwn-manager] ERROR at line $LINENO in ${FUNCNAME[0]:-main}: $BASH_COMMAND (exit $?)" >&2' ERR

# nwn-manager — multi-module manager for NWN1 .mod files (git-friendly,
# LLM-editable workflow). Thin wrapper around nasher (squattingmonk/nasher)
# and the neverwinter.nim CLIs (niv/neverwinter.nim).

PROG=$(basename "$0")
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

usage() {
  cat <<EOF
$PROG — multi-module manager for NWN1 .mod files.

Usage:
  $PROG init <project-dir> <module.mod>
                          Create a new module project. Initializes
                          nasher.cfg, populates <dir>/unpacked/ from
                          <module.mod>, writes .gitignore and a stub
                          README.md.

  $PROG unpack [<module.mod>]
                          Refresh ./unpacked/ from the .mod. With no
                          argument, re-unpacks the path stored in
                          .nasher/source. Run from inside a project
                          (or any subdir).

  $PROG repack [args...]  Build .mod from ./unpacked/ via 'nasher
                          pack'. If a path is recorded in
                          .nasher/source, copy the built .mod there.
                          Extra args pass through to nasher.

  $PROG wiki [--out <dir>] [args...]
                          Generate a static HTML wiki from
                          ./unpacked/ into <project>/docs/ (or --out).
                          docs/ is the folder GitHub Pages publishes
                          from. Extra args pass through to nwn-wiki.

  $PROG serve --log-dir <dir> [options]
                          Monitor player activity via NWN server logs.
                          Polls every 5 minutes (configurable). When
                          the last player leaves, optionally refreshes
                          activity.html and publishes it to git.

                          Options:
                            --log-dir <dir>        NWN server log dir
                                                   (repeat for multiple)
                            --poll-interval <min>  Check interval in
                                                   minutes (default: 5)
                            --auto-publish         On player session end:
                                                   refresh activity.html,
                                                   git commit, and push
                            --activity-cache <path> JSON session cache
                                                   (default: first
                                                   log-dir/activity-
                                                   sessions.json)

  $PROG -h | --help       Show this help.

Per-project layout (created by 'init'):
  nasher.cfg     project + target config (committed)
  unpacked/      source tree of GFF JSON + .nss scripts (committed)
  dist/          packed .mod output (gitignored)
  docs/          generated wiki — committed; GitHub Pages serves from here
  .nasher/       nasher cache + last-used source path (gitignored)

Prerequisites (must be on PATH):
  nasher              — nimble install nasher
  nwn_gff             — nimble install neverwinter
  nwn_script_comp     — nimble install neverwinter
  python3             — for 'wiki' subcommand
EOF
}

# Verify required external CLIs are available; print install hints if not.
preflight() {
  declare -A HINT=(
    [nasher]="nimble install nasher"
    [nwn_gff]="nimble install neverwinter"
    [nwn_script_comp]="nimble install neverwinter"
    [python3]="install Python 3 (system package)"
  )
  local missing=0
  for bin in "$@"; do
    if ! command -v "$bin" >/dev/null 2>&1; then
      echo "error: required tool '$bin' not on PATH" >&2
      [[ -n "${HINT[$bin]:-}" ]] && echo "       install with: ${HINT[$bin]}" >&2
      missing=1
    fi
  done
  [[ $missing -eq 0 ]] || exit 1
}

# Walk up from cwd to find a directory containing nasher.cfg.
# Echoes the directory on success, returns 1 if not found.
find_project_root() {
  local d=$PWD
  while [[ $d != "/" ]]; do
    if [[ -f "$d/nasher.cfg" ]]; then
      echo "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

# nwn_erf chokes on apostrophes (and is fragile around spaces) in input
# paths. Always invoke nasher against a sanitized symlink in /tmp.
# Echoes the safe path.
sanitize_mod_path() {
  local src=$1
  if [[ ! -f $src ]]; then
    echo "error: $src not found" >&2
    return 1
  fi
  local abs base clean link
  abs=$(realpath "$src")
  base=$(basename "$abs")
  clean=$(printf '%s' "$base" | tr -c '[:alnum:]._-' '_')
  link="/tmp/nwnmgr_${clean}"
  ln -sfn "$abs" "$link"
  printf '%s\n' "$link"
}

# Detect the NWN game-data install root for TLK extraction.
# Resolution order:
#   1. $NWN_INSTALL (if set and exists)
#   2. Walk up from .nasher/source assuming <install>/data/mod/<name>.mod
#      (legacy path — was true when .mod lived in the Steam install dir)
#   3. Fixed fallback list of common Steam install locations on Linux
#
# Note: the EE *user* directory (~/.local/share/Neverwinter Nights/) does
# NOT count as an "install" here — it has no dialog.tlk. When the .mod
# lives in <userdir>/modules/<name>.mod (the modern layout), .nasher/source
# can't help us find dialog.tlk and we fall through to the fallback list.
detect_nwn_install() {
  if [[ -n "${NWN_INSTALL:-}" && -d "$NWN_INSTALL" ]]; then
    printf '%s\n' "$NWN_INSTALL"; return 0
  fi

  if [[ -f .nasher/source ]]; then
    local mod_path mod_dir parent
    mod_path=$(cat .nasher/source)
    mod_dir=$(dirname "$mod_path")
    parent=$(dirname "$mod_dir")
    if [[ "$(basename "$mod_dir")" == "mod" && "$(basename "$parent")" == "data" ]]; then
      printf '%s\n' "$(dirname "$parent")"
      return 0
    fi
  fi

  local cand
  for cand in \
    "$HOME/.local/share/Steam/steamapps/common/Neverwinter Nights" \
    "/var/home/$USER/.local/share/Steam/steamapps/common/Neverwinter Nights" \
    "$HOME/.steam/steam/steamapps/common/Neverwinter Nights" \
    "/opt/nwn"
  do
    if [[ -f "$cand/lang/en/data/dialog.tlk" || -f "$cand/data/tlk/dialog.tlk" ]]; then
      printf '%s\n' "$cand"; return 0
    fi
  done
}

# Detect the NWN:EE user directory (where modules/, hak/, override/ live).
# Resolution order: $NWN_USERDIR, then platform defaults.
detect_nwn_userdir() {
  if [[ -n "${NWN_USERDIR:-}" && -d "$NWN_USERDIR" ]]; then
    printf '%s\n' "$NWN_USERDIR"; return 0
  fi
  local cand
  for cand in \
    "$HOME/.local/share/Neverwinter Nights" \
    "/var/home/$USER/.local/share/Neverwinter Nights" \
    "$HOME/Documents/Neverwinter Nights"
  do
    if [[ -d "$cand/hak" || -d "$cand/modules" ]]; then
      printf '%s\n' "$cand"; return 0
    fi
  done
}

# Build the comma-separated list of hak file paths the module declares in
# its Mod_HakList. Each hak is symlinked into /tmp under a no-space name
# so it survives nasher's whitespace-splitting of --nssFlags. Echoes the
# comma-separated list, or empty if module.ifo.json or userdir is missing.
build_compiler_erfs() {
  [[ -f unpacked/module.ifo.json ]] || return 0
  local userdir
  userdir=$(detect_nwn_userdir) || return 0
  [[ -d "$userdir/hak" ]] || return 0

  local haks
  haks=$(python3 -c '
import json, sys
try:
    d = json.load(open("unpacked/module.ifo.json"))
    for h in d.get("Mod_HakList", {}).get("value", []):
        n = h.get("Mod_Hak", {}).get("value", "").strip()
        if n: print(n)
except Exception:
    pass') || return 0

  local out=""
  local h hak link
  while IFS= read -r h; do
    [[ -z $h ]] && continue
    hak="$userdir/hak/${h}.hak"
    if [[ ! -f $hak ]]; then
      echo "[$PROG] warn: declared hak $h.hak not found at $hak — compiler may miss its includes" >&2
      continue
    fi
    link="/tmp/nwnmgr_hak_${h}.hak"
    ln -sfn "$hak" "$link"
    out+="${link},"
  done <<< "$haks"

  out="${out%,}"
  printf '%s\n' "$out"
}

# Extract the base dialog.tlk and the custom TLK (named in module.ifo's
# Mod_CustomTlk, if any) from the NWN install into ./tlk/. Non-fatal: if
# the install can't be located, the wiki still renders but TLK refs stay
# as [TLK#N] placeholders.
extract_tlks() {
  rm -rf tlk
  mkdir -p tlk

  local install
  install=$(detect_nwn_install)
  if [[ -z $install ]]; then
    echo "[$PROG] NWN install not detected (set NWN_INSTALL=...) — skipping TLK extract" >&2
    return 0
  fi

  local dialog=""
  for cand in "$install/lang/en/data/dialog.tlk" "$install/data/tlk/dialog.tlk"; do
    [[ -f $cand ]] && { dialog=$cand; break; }
  done
  if [[ -n $dialog ]]; then
    cp "$dialog" tlk/dialog.tlk
    echo "[$PROG] copied $dialog → tlk/dialog.tlk"
  else
    echo "warn: dialog.tlk not found under $install" >&2
  fi

  local custom_name=""
  if [[ -f unpacked/module.ifo.json ]]; then
    custom_name=$(python3 -c '
import json, sys
try:
    d = json.load(open("unpacked/module.ifo.json"))
    v = d.get("Mod_CustomTlk", {}).get("value", "")
    print(str(v).strip())
except Exception:
    pass' 2>/dev/null || true)
  fi
  if [[ -n $custom_name ]]; then
    local custom=""
    for cand in "$install/data/tlk/${custom_name}.tlk" "$install/lang/en/data/${custom_name}.tlk"; do
      [[ -f $cand ]] && { custom=$cand; break; }
    done
    if [[ -n $custom ]]; then
      cp "$custom" "tlk/${custom_name}.tlk"
      echo "[$PROG] copied $custom → tlk/${custom_name}.tlk"
    else
      echo "warn: custom TLK '${custom_name}.tlk' not found under $install" >&2
    fi
  fi
}

# Append a literal entry to .gitignore if missing. Idempotent so existing
# projects pick up the /tlk/ rule the first time they re-unpack.
ensure_gitignore_entry() {
  local entry=$1
  [[ -f .gitignore ]] || return 0
  grep -qxF "$entry" .gitignore && return 0
  printf '%s\n' "$entry" >> .gitignore
  echo "[$PROG] added '$entry' to .gitignore"
}

# Print a one-line summary of unpacked/ contents.
print_unpacked_summary() {
  [[ -d unpacked ]] || return 0
  local total
  total=$(find unpacked -type f | wc -l)
  echo "[$PROG] unpacked/ summary:"
  echo "  total files: $total"
  find unpacked -type f \
    | sed -n 's/.*\.\([^./]*\)$/\1/p' \
    | sort | uniq -c | sort -rn \
    | sed 's/^/  /'
}

cmd_init() {
  if [[ $# -lt 2 ]]; then
    echo "error: init requires <project-dir> <module.mod>" >&2
    echo "usage: $PROG init <project-dir> <module.mod>" >&2
    exit 2
  fi
  local project=$1 mod=$2
  if [[ -e $project && -n "$(ls -A "$project" 2>/dev/null)" ]]; then
    echo "error: $project exists and is not empty" >&2
    exit 1
  fi
  if [[ ! -f $mod ]]; then
    echo "error: module not found: $mod" >&2
    exit 1
  fi

  local mod_abs
  mod_abs=$(realpath "$mod")
  mkdir -p "$project"
  project=$(realpath "$project")
  cd "$project"

  local clean_mod
  clean_mod=$(sanitize_mod_path "$mod_abs")

  echo "[$PROG] initializing $project from $mod_abs"
  # nasher init creates nasher.cfg and a src/ tree from the .mod.
  # --default + --skipPkgInfo + --yes keeps it non-interactive. We
  # post-rewrite src → unpacked below.
  nasher init --default --skipPkgInfo --yes . "$clean_mod"

  if [[ -d src ]]; then
    mv src unpacked
  fi
  # Patch nasher.cfg: src → unpacked in include + rules.
  sed -i \
    -e 's|"src/\*\*|"unpacked/**|g' \
    -e 's|"\*" = "src"|"*" = "unpacked"|g' \
    nasher.cfg

  mkdir -p .nasher
  printf '%s\n' "$mod_abs" > .nasher/source

  # Per-project .gitignore. tlk/ is sourced from the NWN install at unpack time.
  cat > .gitignore <<'EOF'
/.nasher/
/dist/
/tlk/
*.mod
*.ncs
*.erf
*.hak
EOF

  # Stub README (don't overwrite if the user-or-nasher already wrote one).
  if [[ ! -f README.md ]]; then
    local mod_basename
    mod_basename=$(basename "$mod_abs")
    cat > README.md <<EOF
# $(basename "$project")

NWN1 module project unpacked from \`$mod_basename\` for git-friendly,
LLM-editable editing.

## Workflow

\`\`\`
nwn-manager unpack       # refresh unpacked/ from the .mod
# edit JSON / .nss in unpacked/
nwn-manager repack       # build .mod and copy back to install location
nwn-manager wiki         # regenerate docs/ (committed; published by GitHub Pages)
\`\`\`

The source/install path is recorded in \`.nasher/source\` (per-machine,
gitignored). Pass an explicit path to \`unpack\` to point at a different
.mod.
EOF
  fi

  print_unpacked_summary
  echo "[$PROG] project ready at: $project"
}

cmd_unpack() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    echo "       run '$PROG init <dir> <module.mod>' to create one" >&2
    exit 1
  }
  cd "$root"

  local mod=""
  if [[ $# -ge 1 ]]; then
    mod=$(realpath "$1")
    [[ -f $mod ]] || { echo "error: $mod not found" >&2; exit 1; }
    mkdir -p .nasher
    printf '%s\n' "$mod" > .nasher/source
  elif [[ -f .nasher/source ]]; then
    mod=$(cat .nasher/source)
    [[ -f $mod ]] || {
      echo "error: stored source $mod no longer exists" >&2
      echo "       pass an explicit path: $PROG unpack <module.mod>" >&2
      exit 1
    }
  else
    echo "error: no .nasher/source recorded; pass <module.mod> explicitly" >&2
    exit 1
  fi

  local clean_mod
  clean_mod=$(sanitize_mod_path "$mod")
  # Wipe unpacked/ first so resources deleted in the toolset don't linger
  # in the source tree (and silently sneak back into the next repack).
  if [[ -d unpacked ]]; then
    echo "[$PROG] clearing $root/unpacked/"
    rm -rf unpacked
  fi
  echo "[$PROG] unpacking $mod → $root/unpacked/"
  nasher unpack --yes --file:"$clean_mod"

  ensure_gitignore_entry "/tlk/"
  extract_tlks

  print_unpacked_summary
}

# Read the `file = "..."` value from the first [target] in nasher.cfg.
# Echoes the bare filename or empty if not found. Used to locate the .mod
# nasher just packed; nasher writes it to the project root by default.
nasher_target_file() {
  [[ -f nasher.cfg ]] || return 0
  awk '
    /^\[target/ { in_target=1; next }
    /^\[/        { in_target=0 }
    in_target && /^[[:space:]]*file[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*"?/, "")
      sub(/"?[[:space:]]*$/, "")
      print; exit
    }
  ' nasher.cfg
}

cmd_repack() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    exit 1
  }
  cd "$root"

  # Build --erfs flag pointing at the haks the module declares so the
  # script compiler can resolve includes (e.g. zep_inc_main.nss,
  # ITEM_PROPERTY_BOOMERANG, gplotAppraiseOpenStore from CEP / engine
  # base). Without this, nasher only sees nss in unpacked/ and most
  # CEP-dependent scripts fail to compile.
  local erfs
  erfs=$(build_compiler_erfs)
  local pack_args=(--yes)
  if [[ -n $erfs ]]; then
    # -y: continue past per-script errors so we see the full picture instead
    # of stopping at the first one and reporting "0 of N compiled".
    pack_args+=("--nssFlags:-y --erfs=$erfs")
    echo "[$PROG] compiler --erfs: $erfs"
  fi

  # Wrap nwn_script_comp so the --root/--userdirectory paths nasher
  # auto-detects (which contain "Neverwinter Nights" with a space) get
  # symlinked to no-space /tmp paths before invocation.
  local wrapper="$SCRIPT_DIR/nwn_script_comp_wrapper"
  if [[ -x $wrapper ]]; then
    pack_args+=("--nssCompiler:$wrapper")
  fi

  nasher pack "${pack_args[@]}" "$@"

  # nasher's default output location is the project root, named per the
  # target's `file = ...`. Older configs that route through dist/ still work
  # via the fallback below.
  local built=""
  local target_file
  target_file=$(nasher_target_file)
  if [[ -n $target_file && -f $target_file ]]; then
    built=$(realpath "$target_file")
  elif [[ -d dist ]]; then
    built=$(ls -t dist/*.mod 2>/dev/null | head -1 || true)
    [[ -n $built ]] && built=$(realpath "$built")
  fi

  if [[ -z $built ]]; then
    echo "[$PROG] no built .mod found at project root or in dist/ — skipping install copy" >&2
    return 0
  fi
  echo "[$PROG] built: $built"

  if [[ -f .nasher/source ]]; then
    local install
    install=$(cat .nasher/source)
    if [[ ! -d $(dirname "$install") ]]; then
      echo "[$PROG] install dir $(dirname "$install") does not exist — skipping copy" >&2
      return 0
    fi
    cp -v "$built" "$install"
    echo "[$PROG] installed to: $install"
  fi
}

cmd_wiki() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    exit 1
  }
  cd "$root"

  # Export TZ from server.env so activity-page timezone label is correct.
  # shellcheck disable=SC1091
  [[ -f server.env ]] && . server.env && export TZ

  local out=docs
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        [[ -n ${2:-} ]] || { echo "error: --out requires a directory" >&2; exit 2; }
        out=$2; shift 2
        ;;
      *) break ;;
    esac
  done

  local tlk_args=()
  if [[ -f tlk/dialog.tlk ]]; then
    tlk_args+=(--dialog-tlk tlk/dialog.tlk)
  else
    local install
    install=$(detect_nwn_install || true)
    if [[ -n $install ]]; then
      for _cand in "$install/lang/en/data/dialog.tlk" "$install/data/tlk/dialog.tlk"; do
        if [[ -f $_cand ]]; then
          tlk_args+=(--dialog-tlk "$_cand")
          echo "[$PROG] using dialog.tlk from $_cand"
          break
        fi
      done
    fi
  fi
  local custom=""
  for f in tlk/*.tlk; do
    [[ -f $f ]] || continue
    [[ "$(basename "$f")" == "dialog.tlk" ]] && continue
    custom=$f
    break
  done
  if [[ -n $custom ]]; then
    tlk_args+=(--custom-tlk "$custom")
  fi

  exec "$SCRIPT_DIR/nwn-wiki" --src unpacked --out "$out" "${tlk_args[@]}" "$@"
}

cmd_serve() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside a project (no nasher.cfg found)" >&2
    exit 1
  }
  cd "$root"

  # Export TZ from server.env so activity-page timezone label is correct.
  # shellcheck disable=SC1091
  [[ -f server.env ]] && . server.env && export TZ

  local log_dirs=()
  local poll_interval=5
  local auto_publish=0
  local activity_cache=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --log-dir)
        [[ -n ${2:-} ]] || { echo "error: --log-dir requires a directory" >&2; exit 2; }
        log_dirs+=("$2"); shift 2
        ;;
      --poll-interval)
        [[ -n ${2:-} ]] || { echo "error: --poll-interval requires a number" >&2; exit 2; }
        poll_interval=$2; shift 2
        ;;
      --auto-publish)
        auto_publish=1; shift
        ;;
      --activity-cache)
        [[ -n ${2:-} ]] || { echo "error: --activity-cache requires a path" >&2; exit 2; }
        activity_cache=$2; shift 2
        ;;
      *) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  if [[ ${#log_dirs[@]} -eq 0 ]]; then
    echo "error: at least one --log-dir is required" >&2
    usage >&2
    exit 2
  fi

  local wiki_activity="$SCRIPT_DIR/nwn-wiki-activity"
  if [[ ! -f $wiki_activity ]]; then
    echo "error: nwn-wiki-activity not found at $wiki_activity" >&2
    exit 1
  fi

  local log_dir_args=()
  for d in "${log_dirs[@]}"; do
    log_dir_args+=(--log-dir "$d")
  done
  local cache_args=()
  [[ -n $activity_cache ]] && cache_args+=(--activity-cache "$activity_cache")

  local poll_secs=$(( poll_interval * 60 ))
  local publish_label
  publish_label=$([ $auto_publish -eq 1 ] && echo "enabled" || echo "disabled")

  echo "[$PROG] serve: monitoring player activity every ${poll_interval}m" \
       "(auto-publish: ${publish_label})"
  echo "[$PROG] serve: project root: $root"

  while true; do
    # Trigger when: no players currently online AND a logout occurred within
    # the last poll window.  This fires at most once per poll period per
    # session end, naturally self-clears when the window expires, and
    # survives monitor restarts without any saved state.
    if python3 "$wiki_activity" --check-should-refresh "$poll_secs" \
        "${log_dir_args[@]}" "${cache_args[@]}" 2>/dev/null; then
      echo "[$PROG] serve: $(date '+%Y-%m-%d %H:%M:%S') — no players + recent logout; refreshing activity page"
      if python3 "$wiki_activity" \
          --src unpacked --out docs \
          "${log_dir_args[@]}" "${cache_args[@]}"; then
        echo "[$PROG] serve: activity page refreshed"
        if [[ $auto_publish -eq 1 ]]; then
          local ts
          ts=$(date '+%Y-%m-%d %H:%M:%S')
          if [[ -z "$(git -C "$root" status --porcelain -- docs/activity.html 2>/dev/null)" ]]; then
            echo "[$PROG] serve: no changes to activity.html; skipping commit"
          else
            git -C "$root" add -- docs/activity.html
            git -C "$root" commit -m "Auto Wiki Activity Refresh: $ts"
            git -C "$root" push
            echo "[$PROG] serve: committed and pushed activity update ($ts)"
          fi
        fi
      else
        echo "[$PROG] serve: warn: activity page refresh failed" >&2
      fi
    fi
    sleep "$poll_secs"
  done
}

main() {
  case "${1:-}" in
    init)
      shift; preflight nasher nwn_gff nwn_script_comp
      cmd_init "$@"
      ;;
    unpack)
      shift; preflight nasher nwn_gff nwn_script_comp
      cmd_unpack "$@"
      ;;
    repack)
      shift; preflight nasher nwn_gff nwn_script_comp
      cmd_repack "$@"
      ;;
    wiki)
      shift; preflight python3
      cmd_wiki "$@"
      ;;
    serve)
      shift; preflight python3
      cmd_serve "$@"
      ;;
    -h|--help|"")
      usage
      ;;
    *)
      echo "error: unknown subcommand: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
