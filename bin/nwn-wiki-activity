#!/usr/bin/env python3
"""Regenerate the wiki activity page (activity.html) from NWN server logs.

Run standalone to refresh activity.html without rebuilding the full wiki.
Called automatically by nwn-wiki during full wiki builds.

Exit codes for check modes:
  --check-online:          0 = players online,  1 = no players online
  --check-should-refresh:  0 = should refresh,  1 = should not refresh
"""
from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timedelta
from pathlib import Path


def _load_nwn_wiki():
    """Import the module that owns the wiki generator's globals.

    Returns nwn_wiki.cli, not the nwn_wiki package: this script sets module
    attributes on the result (see main()), and those writes are only visible to
    the code that reads them if they land on the module that defines them.
    """
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from nwn_wiki import cli
    return cli


def _should_refresh(activity: dict, within_seconds: int) -> bool:
    """Return True when the activity monitor should trigger a refresh.

    Conditions (both must hold):
      - No player is currently online (no open session with role=Player).
      - At least one player logout occurred within the last within_seconds seconds.

    Log timestamps are naive datetimes parsed in the server's local timezone
    (TZ env var); datetime.now() is also naive local time, so the comparison
    is consistent as long as TZ matches the server configuration.
    """
    cutoff = datetime.now() - timedelta(seconds=within_seconds)
    sessions = activity["sessions"]
    has_open_player = any(
        s for s in sessions
        if s.get("leave") is None and s.get("role") == "Player"
    )
    if has_open_player:
        return False
    recent_logout = any(
        s for s in sessions
        if s.get("role") == "Player"
        and s.get("leave") is not None
        and s["leave"] >= cutoff
    )
    return recent_logout


def _render_player_pages(wiki, args, activity: dict, out: "Path",
                         activity_cache: "Path") -> None:
    """Refresh the character index, character pages and leaderboards.

    Mirrors nwn_wiki.cli._load_players so the two entry points cannot disagree
    about how a character record is built. Best-effort: a vault that cannot be
    read must never take the activity refresh down with it, because this runs
    unattended from the serve loop.
    """
    from nwn_wiki import state
    from nwn_wiki.players import bicreader, identity, model, sources
    from nwn_wiki.render.achievements import render_achievements
    from nwn_wiki.render.characters import (render_character_index,
                                            render_character_pages)
    from nwn_wiki.render.leaderboards import render_leaderboards
    from nwn_wiki.render.players import (render_player_pages,
                                         render_players_index)

    vault = Path(args.vault_dir).expanduser()
    if not vault.is_dir():
        print(f"[nwn-wiki-activity] warn: --vault-dir {vault} is not a directory; "
              "skipping the player pages", file=sys.stderr)
        return

    cache_path = (Path(args.vault_cache).expanduser() if args.vault_cache
                  else activity_cache.with_name("vault-characters.json"))

    try:
        chars = bicreader.load_vault(vault, cache_path=cache_path)
    except OSError as exc:
        print(f"[nwn-wiki-activity] warn: could not read the vault: {exc}",
              file=sys.stderr)
        return
    if not chars:
        return

    kills, catalogue, admin_cdkeys = [], {}, set()
    if args.db_dir:
        db_dir = Path(args.db_dir).resolve()
        bes = sources.open_ro(db_dir / "bestiarydb.sqlite3")
        if bes is not None:
            kills = sources.load_kills(bes)
            catalogue = sources.load_catalogue(bes)
        adm = sources.open_ro(db_dir / "admindb.sqlite3")
        if adm is not None:
            admin_cdkeys = sources.load_admin_cdkeys(adm)

    sessions = activity["sessions"]
    identity.configure()
    roster = identity.build_roster(sessions, kills, chars)
    state._CHARACTERS = model.build_records(chars, kills, sessions, roster,
                                            catalogue,
                                            exclude_cdkeys=admin_cdkeys)
    state._PLAYERS = model.build_players(state._CHARACTERS)
    state._PLAYER_SLUGS = {p["name"]: p["slug"] for p in state._PLAYERS}
    # This pass has no module database, so item pages cannot be enumerated from
    # blueprints. Read the ones the last full build wrote instead, so equipped
    # gear keeps its links here too.
    state._ITEM_PAGES = {f.stem for f in (out / "items").glob("*.html")}
    try:
        _pd = json.loads((out / ".players-data.json").read_text(encoding="utf-8"))
        state._ITEM_NAMES = _pd.get("item_names") or {}
        state._MAX_ABILITY_BONUS = int(_pd.get("max_ability_bonus") or 12)
    except (OSError, ValueError, TypeError):
        # Names and the ability cap both come from the module DB, which this
        # pass does not have. Rendering without them would silently disagree
        # with the last full build, so say so rather than quietly differ.
        print("[nwn-wiki-activity] warn: no readable .players-data.json; "
              "gear names and the ability cap may differ from the full build",
              file=sys.stderr)
        state._ITEM_NAMES = {}

    render_character_index(out)
    render_character_pages(out)
    render_leaderboards(out)
    render_players_index(out)
    render_player_pages(out)
    render_achievements(out)
    print(f"[nwn-wiki-activity] players: refreshed "
          f"{len(state._CHARACTERS)} character page(s)")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument(
        "--src", default=None,
        help="path to the unpacked/ tree (for wiki theme and manual-pages nav; "
             "required unless a --check-* mode is used)",
    )
    ap.add_argument(
        "--out", default=None,
        help="path to wiki output dir (docs/); required unless a --check-* mode is used",
    )
    ap.add_argument(
        "--log-dir", action="append", default=[], dest="log_dirs", metavar="DIR",
        help="Directory containing NWN server logs (nwserverLog*.txt), or a parent "
             "directory whose subdirectories contain them (e.g. logs.0/, logs.1/). "
             "Repeat for multiple log roots.",
    )
    ap.add_argument(
        "--activity-cache", default=None, dest="activity_cache", metavar="PATH",
        help="JSON file for persisting player-session data across log rotations. "
             "Defaults to activity-sessions.json inside the first --log-dir.",
    )
    ap.add_argument(
        "--db-dir", default=None, dest="db_dir", metavar="DIR",
        help="Path to the campaign database directory containing bestiarydb.sqlite3. "
             "When provided, the Server Firsts page is also refreshed alongside "
             "activity.html and existing server-first records are back-filled with "
             "player names derived from the log sessions.",
    )
    ap.add_argument(
        "--vault-dir", default=None, dest="vault_dir", metavar="DIR",
        help="Server vault directory (servervault/<CDKEY>/*.bic). When provided "
             "alongside --db-dir, the character index, the per-character pages and "
             "the leaderboards are refreshed too, so they stay in step with the "
             "kill counts the same pass writes into Server Firsts.",
    )
    ap.add_argument(
        "--vault-cache", default=None, dest="vault_cache", metavar="PATH",
        help="JSON cache of parsed .bic files. Defaults to vault-characters.json "
             "beside the activity cache. Parsing a full vault costs ~18s cold and "
             "~0.3s warm; without this the on-empty refresh pays the cold cost "
             "every time.",
    )
    ap.add_argument(
        "--online-since", type=int, default=None, dest="online_since", metavar="EPOCH",
        help="Unix timestamp floor for 'currently online' detection. Sessions still "
             "open in the logs that began before this time are treated as stale "
             "leftovers from a previous server run (killed without a clean leave) "
             "and are not reported as online. Set by 'nwn-manager serve' to its own "
             "start time, since the server is (re)started alongside the monitor.",
    )
    ap.add_argument(
        "--check-online", action="store_true",
        help="Exit 0 if at least one player is currently online, 1 if not. "
             "No output files are written.",
    )
    ap.add_argument(
        "--check-should-refresh", type=int, default=None, metavar="SECONDS",
        help="Exit 0 if no players are currently online AND at least one player "
             "logout occurred within the last SECONDS seconds. No files are written. "
             "Designed for the poll loop in 'nwn-manager serve'.",
    )
    args = ap.parse_args()

    if not args.log_dirs:
        print("error: at least one --log-dir is required", file=sys.stderr)
        return 2

    wiki = _load_nwn_wiki()

    log_dir_paths = [Path(d).resolve() for d in args.log_dirs]
    cache_path = (
        Path(args.activity_cache).resolve()
        if args.activity_cache
        else log_dir_paths[0] / "activity-sessions.json"
    )

    online_floor = (
        datetime.fromtimestamp(args.online_since)
        if args.online_since is not None
        else None
    )
    activity = wiki.parse_nwserver_logs(
        log_dir_paths, cache_path=cache_path, online_floor=online_floor
    )

    if args.check_online:
        online = any(
            s for s in activity["sessions"]
            if s.get("leave") is None and s.get("role") == "Player"
        )
        return 0 if online else 1

    if args.check_should_refresh is not None:
        return 0 if _should_refresh(activity, args.check_should_refresh) else 1

    if not args.src or not args.out:
        print("error: --src and --out are required (or use a --check-* mode)",
              file=sys.stderr)
        return 2

    src = Path(args.src).resolve()
    out = Path(args.out).resolve()

    player_sessions = [
        s for s in activity["sessions"]
        if s.get("join") is not None and s.get("role") == "Player"
    ]
    if not player_sessions:
        print("[nwn-wiki-activity] no player sessions found; nothing to render",
              file=sys.stderr)
        return 0

    # Set the state required by page() and render_activity_page().  These must
    # land on nwn_wiki.state, the module that defines them -- setting them on
    # any other module object would leave the readers seeing the defaults.
    from nwn_wiki import state
    from nwn_wiki.htmlgen.chrome import SiteChrome
    state._GENERATED_AT = datetime.now().strftime("%b %-d, %Y %H:%M")

    # The nav bar is NOT recomputed here. This process rewrites activity.html
    # and every manual/**.html, but the rest of the wiki was written by another
    # interpreter; anything derived independently here could disagree with it.
    # So the main build serialises its resolved nav facts to <out>/.chrome.json
    # and we render from exactly those.
    chrome = SiteChrome.load(out)
    if chrome is not None:
        state.CHROME = chrome
        if not chrome.has_activity:
            # The last full build saw no player sessions, so no page links to
            # activity.html. Write it anyway (it is now non-empty) but leave
            # the nav alone -- the next full wiki build turns the link on
            # everywhere at once.
            print("[nwn-wiki-activity] .chrome.json has no activity page yet; "
                  "rendering activity.html without adding the nav link",
                  file=sys.stderr)
    else:
        # Older wiki tree (or an unreadable chrome file): fall back to deriving
        # the nav facts the way this script used to, which can drift from the
        # rest of the tree but is better than rendering a nav-less shell.
        print(f"[nwn-wiki-activity] no readable {out}/.chrome.json; deriving "
              "nav state locally (run a full nwn-wiki build to fix)",
              file=sys.stderr)
        state._HAS_ACTIVITY_PAGE = True
        wiki.load_boss_registry_from_src(src)

    # Re-copy the module theme assets into out/assets/ (idempotent). The nav
    # and page-shell theme facts come from the chrome file when we have one.
    wiki.load_wiki_theme(src.parent, out)

    if args.db_dir:
        db_dir = Path(args.db_dir).resolve()
        wiki.backfill_server_first_player_names(db_dir, activity["sessions"])
        wiki.load_bestiary_stats(db_dir)

    # Re-render the manual pages so their content is current (and, when
    # --db-dir was given and _BESTIARY_ACTIVE is True, so ServerFirsts.html
    # picks up the new data). render_manual_pages is idempotent; re-writing
    # existing pages is harmless, and with no docs.manual/ it writes only that
    # generated page. Their nav comes from the chrome file, not from the menus
    # this call rebuilds.
    wiki.render_manual_pages(src.parent, out)

    wiki.render_activity_page(activity, out, tz_label=wiki._tz_label_from_env())

    # Player pages, when this realm has a vault. Gated on --vault-dir exactly
    # like the main build, so a module with no server behind it never grows a
    # Players section here either. The nav still comes from .chrome.json: this
    # pass rewrites existing pages, and only a full build can add the nav entry.
    if args.vault_dir:
        _render_player_pages(wiki, args, activity, out, cache_path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
