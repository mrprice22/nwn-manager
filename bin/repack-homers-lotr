#!/usr/bin/env bash
# Desktop-launcher target: repack Homer's LotR from ./unpacked/ into a .mod
# and copy it to the install location recorded in .nasher/source.
#
# nasher reports "N errored" for known-broken scripts (zep_cr_*, openstore_*,
# dmw_do_dialog*, etc.) — all benign, documented in bin/CLAUDE.md. The script
# exits on any such errors by default; pass --force to proceed anyway.
#
# Options:
#   --verbose   Show full nasher output (default: quiet % progress only)
#   --force     Continue despite errors or warnings reported by nasher

set -o pipefail

VERBOSE=0
FORCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose) VERBOSE=1 ;;
    --force)   FORCE=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

PROJECT=/var/home/james/GIT/nwn_homers_lotr
NWN_MANAGER_BIN=/var/home/james/GIT/nwn_manager/bin

export PATH="$HOME/.nimble/bin:$NWN_MANAGER_BIN:$PATH"

cd "$PROJECT" || { echo "missing project: $PROJECT"; read -rp "Press Enter..."; exit 1; }

rm -f homers_lotr_v3.mod

start=$(date +%s)

tmpout=$(mktemp)
trap 'rm -f "$tmpout"' EXIT

if [[ $VERBOSE -eq 1 ]]; then
  nwn-manager repack 2>&1 | tee "$tmpout"
  nasher_status="${PIPESTATUS[0]}"
else
  nwn-manager repack >"$tmpout" 2>&1 &
  bg_pid=$!
  spin='|/-\'
  si=0
  phase="starting"
  phase_locked=0  # once we see "packing" we stop checking for earlier phases

  while kill -0 "$bg_pid" 2>/dev/null; do
    elapsed=$(( $(date +%s) - start ))

    # Advance phase only forward (convert → compile → pack)
    if [[ $phase_locked -eq 0 ]]; then
      if grep -qE "^Packing " "$tmpout" 2>/dev/null; then
        phase="packing"; phase_locked=1
      elif grep -qE "^Compiling " "$tmpout" 2>/dev/null && [[ $phase != compiling* ]]; then
        n=$(grep -oE "^Compiling [0-9]+" "$tmpout" 2>/dev/null | grep -oE "[0-9]+" | head -1)
        phase="compiling ${n:-?} scripts"
      elif grep -qE "^Updating " "$tmpout" 2>/dev/null && [[ $phase == starting ]]; then
        phase="converting"
      fi
    fi

    errors=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || errors=0
    ch="${spin:$si:1}"; si=$(( (si + 1) % 4 ))

    if [[ $errors -gt 0 ]]; then
      printf "\r[repack] %s %s  (%ds, %d errors)          " \
        "$ch" "$phase" "$elapsed" "$errors"
    else
      printf "\r[repack] %s %s  (%ds)          " "$ch" "$phase" "$elapsed"
    fi
    sleep 0.3
  done

  wait "$bg_pid"
  nasher_status=$?
  elapsed=$(( $(date +%s) - start ))
  errors=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || errors=0
  if [[ $errors -gt 0 ]]; then
    printf "\r[repack] done in %ds  (%d compile errors)          \n" "$elapsed" "$errors"
  else
    printf "\r[repack] done in %ds          \n" "$elapsed"
  fi
fi

# Separate compile-level errors (expected benign failures in zep_cr_*, openstore_*,
# dmw_do_dialog*, etc.) from nasher-level failures (pack/install errors).
# Nasher non-tty format has no leading spaces, unlike tty-indented output.
compile_err_count=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || compile_err_count=0
fatal_lines=$(grep -E "^Error:" "$tmpout" 2>/dev/null || true)

if [[ $nasher_status -ne 0 || -n "$fatal_lines" ]]; then
  # Always show full nasher output on error; in verbose mode it was already
  # streamed live, so only dump it here for the quiet (default) path.
  if [[ $VERBOSE -eq 0 ]]; then
    echo
    cat "$tmpout"
  fi
  if [[ $FORCE -eq 1 ]]; then
    echo
    echo "[WARN] nasher reported errors (--force: proceeding anyway)"
  else
    echo
    echo "[ERROR] nasher reported errors — aborting."
    echo "        Re-run with --force to proceed despite errors."
    echo
    read -rp "Press Enter to close..."
    exit 1
  fi
fi

if [[ $compile_err_count -gt 0 ]]; then
  echo "[note] $compile_err_count known compile error(s) suppressed (run --verbose to see)"
fi

echo
echo "=========================================================================="
if [[ -f homers_lotr_v3.mod ]]; then
  built=$(stat -c %Y homers_lotr_v3.mod)
  size=$(stat -c %s homers_lotr_v3.mod)
  size_mb=$(( size / 1024 / 1024 ))
  if [[ $built -ge $start ]]; then
    echo "[OK] homers_lotr_v3.mod rebuilt (${size_mb} MB)"
    echo
    # Copy 1: OneDrive modules dir (primary — used by the Unpack pipeline)
    ONEDRIVE_MOD_DIR="$HOME/OneDrive/Games/NWNHomersLOTR"
    ONEDRIVE_MOD_DEST="$ONEDRIVE_MOD_DIR/homers_lotr_v3.mod"
    if [[ -d $ONEDRIVE_MOD_DIR ]]; then
      cp "homers_lotr_v3.mod" "$ONEDRIVE_MOD_DEST"
      echo "[install] → $ONEDRIVE_MOD_DEST"
    else
      echo "[install] WARNING: $ONEDRIVE_MOD_DIR not found, skipping OneDrive copy"
    fi
    echo
    # Copy 2: local NWN modules dir (for toolset access)
    NWN_MOD_DIR="$HOME/.local/share/Neverwinter Nights/modules"
    NWN_MOD_DEST="$NWN_MOD_DIR/Homer's LOTR VEL v3.mod"
    if [[ -d $NWN_MOD_DIR ]]; then
      cp "homers_lotr_v3.mod" "$NWN_MOD_DEST"
      echo "[install] → $NWN_MOD_DEST"
    else
      echo "[install] WARNING: $NWN_MOD_DIR not found, skipping local NWN copy"
    fi
    echo
    # Copy 3: timestamped archive in project root
    ARCHIVE_DEST="$PROJECT/homers_lotr_v3_$(date +%Y%m%d_%H%M%S).mod"
    cp "homers_lotr_v3.mod" "$ARCHIVE_DEST"
    echo "[archive] → $ARCHIVE_DEST"
    echo
    # Refresh nwsync so connecting EE clients pull the new module's haks/tlk
    # snapshot. Non-fatal: if this fails, the .mod itself is still good.
    if [[ -x "$PROJECT/bin/refresh-nwsync" ]]; then
      echo "--------------------------------------------------------------------------"
      echo "[nwsync] refreshing manifest..."
      nwsync_flags=()
      [[ $VERBOSE -eq 0 ]] && nwsync_flags+=(--silent)
      "$PROJECT/bin/refresh-nwsync" "${nwsync_flags[@]}" || \
        echo "[nwsync] WARNING: refresh failed; the .mod is fine, but clients won't see the latest CEP snapshot until you re-run bin/refresh-nwsync"
      echo
    fi
    echo "Next: launch the server with the 'Host Homer's LotR Server' app-grid"
    echo "      shortcut (or run bin/serve from the project root)."
    status=0
  else
    echo "[STALE] homers_lotr_v3.mod exists but was not updated this run."
    echo "        nasher exit: $nasher_status — check output above."
    status=1
  fi
else
  echo "[FAILED] no homers_lotr_v3.mod produced (nasher exit $nasher_status)"
  status=1
fi
echo
read -rp "Press Enter to close..."
exit $status
