#!/usr/bin/env bash
# Desktop-launcher target: repack Homer's LotR from ./unpacked/ into a .mod
# and copy it to the install location recorded in .nasher/source.
#
# Options:
#   --verbose        Show full nasher output (default: quiet spinner + phase only)
#   --force          Continue despite compile or nasher errors (default: abort)
#   --no-prod        Skip copy to local NWN modules dir (production); OneDrive and archive still written
#   --project DIR    Build that season's repo instead of the default (unnumbered,
#                    newest) one. Artifact name, install path and OneDrive dest
#                    are all derived from DIR's nasher.cfg + server.env.
#   --show-config    Print the resolved paths and exit without building

set -o pipefail

# Yield to the live game server. A repack compiles ~2340 scripts and runs 30+
# smoke tests on a 4-core box that is ALSO hosting the live season, on one
# spinning disk -- this is the job players most often feel as lag.
#
# Done in-process rather than via nwn_manager/bin/lowprio because this wrapper
# is interactive (progress spinner, stdin): re-exec'ing it under systemd-run
# would disturb the terminal. renice/ionice are inherited by nasher, the script
# compiler and the smoke tests alike, which is all we need. Idle I/O class is
# the important half -- the disk is the bottleneck, not the CPU.
#
# REPACK_NICE=0 opts out (e.g. when nothing is running and you want it fast).
if [[ ${REPACK_NICE:-1} != 0 ]]; then
  renice -n 19 -p $$ >/dev/null 2>&1 || true
  ionice -c 3 -p $$  >/dev/null 2>&1 || true
fi

VERBOSE=0
FORCE=0
NO_PROD=0
SHOW_CONFIG=0
REPACK_PROJECT=${NWN_PROJECT:-}
REPACK_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose)  VERBOSE=1 ;;
    --force)    FORCE=1 ;;
    --no-prod)  NO_PROD=1 ;;
    --no-smoke) REPACK_ARGS+=(--no-smoke) ;;  # skip build gates (smoke + dialog check)
    --project)  REPACK_PROJECT=${2:?--project needs a directory}; shift ;;
    --project=*) REPACK_PROJECT=${1#*=} ;;
    --show-config) SHOW_CONFIG=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

# ANSI colors when stdout is a terminal (the app-grid shortcut runs in ptyxis).
if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_RED=''; C_GREEN=''; C_BOLD=''; C_RESET=''
fi

# Hold the window open so a human can read the output -- but ONLY when a human
# is actually there. This script is launched two ways:
#
#   from the app-grid / desktop shortcut, where the terminal closes the instant
#   the process exits and the output would be lost without a pause; and
#
#   programmatically, from season-promote.sh and any other deploy path, where
#   stdin is not a terminal and an unconditional `read` blocks FOREVER -- after
#   the module has already been built and installed. That is how a season-2
#   promotion once wedged with a freshly installed module sitting on the live
#   server and season-promote's own compile-error gate never reached, which is
#   the exact state that gate exists to prevent (2026-08-15).
#
# Set REPACK_NO_PAUSE=1 to suppress it even on a terminal.
pause_if_interactive() {
  [[ -n ${REPACK_NO_PAUSE:-} ]] && return 0
  [[ -t 0 && -t 1 ]] && read -rp "${1:-Press Enter to close...}"
  return 0
}

NWN_MANAGER_BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# shellcheck disable=SC1091
. "$NWN_MANAGER_BIN/build-error-re.sh"

export PATH="$HOME/.nimble/bin:$NWN_MANAGER_BIN:$PATH"

# Resolve PROJECT / MODFILE / NWN_MOD_DEST / ONEDRIVE_MOD_DEST from the target
# repo's nasher.cfg + server.env, so one wrapper serves every season.
# shellcheck disable=SC1091
. "$NWN_MANAGER_BIN/repack-project.sh"
repack_resolve_project || { pause_if_interactive "Press Enter..."; exit 1; }

if [[ $SHOW_CONFIG -eq 1 ]]; then
  echo "[repack] resolved configuration:"
  repack_print_project
  exit 0
fi

# A repack aimed anywhere but the default repo installs into a different
# season's paths — say so before it does.
if [[ $PROJECT != "$REPACK_DEFAULT_PROJECT" ]]; then
  echo "[repack] non-default project:"
  repack_print_project
  echo
fi

cd "$PROJECT" || { echo "missing project: $PROJECT"; pause_if_interactive "Press Enter..."; exit 1; }

rm -f "$MODFILE"

start=$(date +%s)

tmpout=$(mktemp)
trap 'rm -f "$tmpout"' EXIT

if [[ $VERBOSE -eq 1 ]]; then
  # CHECK_DLG_VERBOSE makes the dialog-integrity gate list per-dialog warnings,
  # so verbose shows more detail on what each gate is checking as it runs.
  CHECK_DLG_VERBOSE=1 nwn-manager repack --no-install "${REPACK_ARGS[@]}" 2>&1 | tee "$tmpout"
  nasher_status="${PIPESTATUS[0]}"
else
  nwn-manager repack --no-install "${REPACK_ARGS[@]}" >"$tmpout" 2>&1 &
  bg_pid=$!
  spin='|/-\'
  si=0
  phase="starting"
  phase_locked=0  # once we see "packing" we stop checking for earlier phases

  while kill -0 "$bg_pid" 2>/dev/null; do
    elapsed=$(( $(date +%s) - start ))

    # Advance phase only forward (convert → compile → pack)
    if [[ $phase_locked -eq 0 ]]; then
      if grep -qE "^Packing " "$tmpout" 2>/dev/null; then
        phase="packing"; phase_locked=1
      elif grep -qE "^Compiling " "$tmpout" 2>/dev/null && [[ $phase != compiling* ]]; then
        n=$(grep -oE "^Compiling [0-9]+" "$tmpout" 2>/dev/null | grep -oE "[0-9]+" | head -1)
        phase="compiling ${n:-?} scripts"
      elif grep -qE "^Updating " "$tmpout" 2>/dev/null && [[ $phase == starting ]]; then
        phase="converting"
      fi
    fi

    errors=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || errors=0
    ch="${spin:$si:1}"; si=$(( (si + 1) % 4 ))

    if [[ $errors -gt 0 ]]; then
      printf "\r[repack] %s %s  (%ds, %d errors)          " \
        "$ch" "$phase" "$elapsed" "$errors"
    else
      printf "\r[repack] %s %s  (%ds)          " "$ch" "$phase" "$elapsed"
    fi
    sleep 0.3
  done

  wait "$bg_pid"
  nasher_status=$?
  elapsed=$(( $(date +%s) - start ))
  errors=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || errors=0
  if [[ $errors -gt 0 ]]; then
    printf "\r[repack] done in %ds  (%d compile errors)          \n" "$elapsed" "$errors"
  else
    printf "\r[repack] done in %ds          \n" "$elapsed"
  fi
fi

# Build-gate failures (dialog integrity / smoke tests) abort before packing.
# Surface every offending line in RED, even in quiet mode. Not bypassable with
# --force (use --no-smoke to skip the gates entirely).
if grep -qE "dialog-integrity check FAILED|smoke tests FAILED" "$tmpout"; then
  echo
  echo "${C_RED}${C_BOLD}Build gates FAILED — nothing built or installed:${C_RESET}"
  grep -E "^FAIL |^       |^fail:|^not ok|dialog-integrity check FAILED|smoke tests FAILED|^check-dlg-integrity: scanned" "$tmpout" \
    | while IFS= read -r line; do printf '  %s%s%s\n' "$C_RED" "$line" "$C_RESET"; done
  echo
  printf '  %s(bypass the gates with --no-smoke if you must build anyway)%s\n' "$C_RED" "$C_RESET"
  echo
  pause_if_interactive
  exit 1
fi

compile_err_count=$(grep -cE "^Compile Error:" "$tmpout" 2>/dev/null) || compile_err_count=0
fatal_lines=$(grep -E "^Error:" "$tmpout" 2>/dev/null || true)

# The same full error set nwn-manager gates on (NWNMGR_BUILD_ERROR_RE). This
# used to check only "^Compile Error:" and "^Error:", which let three real
# failure modes through -- a resref longer than 16 characters, an invalid
# target name, and the compiler's own "Results: N errored" / "Compiled only"
# tallies whose wording matches neither. Any of those packed, installed and
# exited 0. nwn-manager now refuses to install on them, so this is the second
# line of defence rather than the only one.
build_err_lines=$(grep -nE "$NWNMGR_BUILD_ERROR_RE" "$tmpout" 2>/dev/null || true)

if [[ $nasher_status -ne 0 || -n "$fatal_lines" || $compile_err_count -gt 0 \
      || -n "$build_err_lines" ]]; then
  if [[ $VERBOSE -eq 0 ]]; then
    echo
    grep -E "^Compile Error:" "$tmpout" | head -40 \
      | while IFS= read -r line; do printf '  %s%s%s\n' "$C_RED" "$line" "$C_RESET"; done
    [[ $compile_err_count -gt 40 ]] && echo "  ${C_RED}... ($((compile_err_count - 40)) more compile errors)${C_RESET}"
    [[ -n "$fatal_lines" ]] && printf '%s\n' "$fatal_lines" \
      | while IFS= read -r line; do printf '  %s%s%s\n' "$C_RED" "$line" "$C_RESET"; done
  fi
  echo
  if [[ $FORCE -eq 1 ]]; then
    echo "${C_RED}[WARN] $compile_err_count compile error(s) (--force: proceeding anyway)${C_RESET}"
  else
    echo "${C_RED}${C_BOLD}[ERROR] $compile_err_count compile error(s) — aborting.${C_RESET}"
    echo "        Re-run with --force to proceed despite errors."
    echo
    pause_if_interactive
    exit 1
  fi
fi

echo
echo "=========================================================================="
if [[ -f $MODFILE ]]; then
  built=$(stat -c %Y "$MODFILE")
  size=$(stat -c %s "$MODFILE")
  size_mb=$(( size / 1024 / 1024 ))
  if [[ $built -ge $start ]]; then
    echo "[OK] $MODFILE rebuilt (${size_mb} MB)"
    echo
    # Green build-gate summary — shown even in quiet mode.
    smoke_sum=$(grep -oE "[0-9]+/[0-9]+ smoke tests passed" "$tmpout" | tail -1)
    if [[ -n $smoke_sum ]]; then
      echo "${C_GREEN}${C_BOLD}✓ ${smoke_sum}${C_RESET}"
    elif grep -q "smoke tests: tests/smoke-test" "$tmpout"; then
      echo "${C_GREEN}${C_BOLD}✓ smoke tests passed${C_RESET}"
    fi
    dlg_sum=$(grep -E "^check-dlg-integrity: scanned " "$tmpout" | tail -1)
    [[ -n $dlg_sum ]] && echo "${C_GREEN}✓ ${dlg_sum}${C_RESET}"
    echo
    # One stamp for copies 1 and 3. Must be set HERE, in the parent shell:
    # repack_build_stamp memoises into BUILD_STAMP, but a $(...) call runs in a
    # subshell, so letting copy 1's command substitution be the first caller
    # left the parent unset and copy 3 minted a second, later stamp.
    repack_build_stamp >/dev/null

    # Copy 1: OneDrive season dir (primary — used by the Unpack pipeline).
    # Created on demand: a brand-new season's subfolder won't exist yet, so only
    # a missing/unmounted OneDrive *root* is worth warning about.
    if [[ -d $ONEDRIVE_ROOT ]]; then
      mkdir -p "$ONEDRIVE_MOD_DIR"
      # Per-build filename, never the plain artifact name. Overwriting one fixed
      # name stopped propagating to the Windows toolset PC; a new name each build
      # is a create rather than a modify, and carries its date on its face.
      ONEDRIVE_BUILD_DEST=$(repack_onedrive_dest)
      cp "$MODFILE" "$ONEDRIVE_BUILD_DEST"
      echo "[install] → $ONEDRIVE_BUILD_DEST"
      # Prune BEFORE the upload so one sync run carries the new file and the
      # deletions together.
      repack_prune_builds "$ONEDRIVE_MOD_DIR" "$REPACK_KEEP_BUILDS" onedrive
      # The copy above is only a LOCAL mirror -- kick off the cloud upload now
      # rather than leaving it to the once-per-boot backup sync.
      repack_onedrive_upload
    else
      echo "[install] WARNING: $ONEDRIVE_ROOT not found, skipping OneDrive copy"
    fi
    echo
    # Copy 2: local NWN modules dir (production deploy — skipped with --no-prod).
    # The destination filename IS the module name: it must match NWN_MODULE.
    if [[ $NO_PROD -eq 0 ]]; then
      if [[ -d $NWN_MOD_DIR ]]; then
        cp "$MODFILE" "$NWN_MOD_DEST"
        echo "[install] → $NWN_MOD_DEST"
      else
        echo "[install] WARNING: $NWN_MOD_DIR not found, skipping local NWN copy"
      fi
    else
      echo "[install] (--no-prod: skipped local NWN modules dir)"
    fi
    echo
    # Copy 3: timestamped archive in project root. Same stamp as the OneDrive
    # copy above, so a build and its local twin are correlatable by name.
    ARCHIVE_DEST="$PROJECT/${MODBASE}_$(repack_build_stamp).mod"
    cp "$MODFILE" "$ARCHIVE_DEST"
    echo "[archive] → $ARCHIVE_DEST"
    repack_prune_builds "$PROJECT" "$REPACK_KEEP_BUILDS" archive
    echo
    echo "Next: launch the server with the 'Host Homer's LotR Server' app-grid"
    echo "      shortcut (or run bin/serve from the project root)."
    status=0
  else
    echo "[STALE] $MODFILE exists but was not updated this run."
    echo "        nasher exit: $nasher_status — check output above."
    status=1
  fi
else
  echo "[FAILED] no $MODFILE produced (nasher exit $nasher_status)"
  status=1
fi
echo
pause_if_interactive
exit $status
