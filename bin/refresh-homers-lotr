#!/usr/bin/env bash
# Desktop-launcher target: unpack Homer's LotR .mod into the unpacked/ source
# tree. Selects the most recently modified .mod from the git project directory
# or the OneDrive modules directory.
# Wiki regeneration is a separate step — use "Regenerate Homer's LotR Wiki".
#
# Options:
#   --verbose   Show full nwn-manager output (default: spinner + summary only)

set -o pipefail

VERBOSE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose) VERBOSE=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

PROJECT=/var/home/james/GIT/nwn_homers_lotr
NWN_MANAGER_BIN=/var/home/james/GIT/nwn_manager/bin

CANDIDATE_DIRS=(
  "$PROJECT"
  "$HOME/OneDrive/Games/NWNHomersLOTR"
)

export PATH="$HOME/.nimble/bin:$NWN_MANAGER_BIN:$PATH"

cd "$PROJECT" || { echo "missing project: $PROJECT"; read -rp "Press Enter..."; exit 1; }

MOD=$(find "${CANDIDATE_DIRS[@]}" -maxdepth 1 -name "*.mod" -type f 2>/dev/null \
  | xargs ls -t 2>/dev/null | head -1)

if [[ -z $MOD ]]; then
  echo "error: no .mod file found in:"
  printf "  %s\n" "${CANDIDATE_DIRS[@]}"
  read -rp "Press Enter..."; exit 1
fi

echo "[unpack] reading: $MOD"
echo "[unpack] into:    $PROJECT/unpacked/"
echo

start=$(date +%s)

if [[ $VERBOSE -eq 1 ]]; then
  nwn-manager unpack "$MOD"
  status=$?
else
  tmpout=$(mktemp)
  trap 'rm -f "$tmpout"' EXIT

  nwn-manager unpack "$MOD" >"$tmpout" 2>&1 &
  bg_pid=$!
  spin='|/-\'
  si=0
  phase="starting"
  phase_order=0  # 0=starting 1=unpacking 2=converting 3=copying

  while kill -0 "$bg_pid" 2>/dev/null; do
    elapsed=$(( $(date +%s) - start ))

    if [[ $phase_order -lt 3 ]] && grep -qE "^\[nwn-manager\] copied" "$tmpout" 2>/dev/null; then
      phase="copying tlk"; phase_order=3
    elif [[ $phase_order -lt 2 ]] && grep -qE "^Converting " "$tmpout" 2>/dev/null; then
      n=$(grep -oE "Converting [0-9]+" "$tmpout" 2>/dev/null | grep -oE "[0-9]+" | head -1)
      phase="converting ${n:-?} files"; phase_order=2
    elif [[ $phase_order -lt 1 ]] && grep -qE "^\[nwn-manager\] unpacking" "$tmpout" 2>/dev/null; then
      phase="unpacking"; phase_order=1
    fi

    ch="${spin:$si:1}"; si=$(( (si + 1) % 4 ))
    printf "\r[unpack] %s %s  (%ds)          " "$ch" "$phase" "$elapsed"
    sleep 0.3
  done

  wait "$bg_pid"
  status=$?
  elapsed=$(( $(date +%s) - start ))
  printf "\r[unpack] done in %ds          \n" "$elapsed"

  if [[ $status -ne 0 ]]; then
    echo
    if [[ -s "$tmpout" ]]; then
      cat "$tmpout"
    else
      echo "[diagnostic] nwn-manager exited $status with no output"
      echo "             Try running with --verbose for full output, or check:"
      echo "               PATH=\$HOME/.nimble/bin:$NWN_MANAGER_BIN:\$PATH \\"
      echo "               nwn-manager unpack \"$MOD\" 2>&1 | head -30"
    fi
  else
    sed -n '/^\[nwn-manager\] unpacked\/ summary:/,$ p' "$tmpout"
  fi
fi

echo
if [[ $status -eq 0 ]]; then
  echo "[done] unpacked → $PROJECT/unpacked/"
  echo "       Run 'Regenerate Homer's LotR Wiki' to rebuild docs."
else
  echo "[FAILED] exit $status"
fi
echo
read -rp "Press Enter to close..."
