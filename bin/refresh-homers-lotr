#!/usr/bin/env bash
# Desktop-launcher target: unpack Homer's LotR .mod into the unpacked/ source
# tree. Selects the most recently modified .mod from the target season's OneDrive
# folder ($ONEDRIVE_ROOT/Season<N>) — the same directory the repack wrappers
# write copy 1 into, so the round-trip is symmetric.
#
# On the DEV realm two folders are scanned: $ONEDRIVE_ROOT/Test (where repack
# writes) and $ONEDRIVE_ROOT/Dev (where toolset round-trips have also been
# landing). Newest across both wins. Seasons scan only their own folder — see
# ONEDRIVE_MOD_DIRS in repack-project.sh for why dev is the only exception.
#
# Newest mtime wins; among files tied for newest, the season's canonical artifact
# name ($MODFILE, from nasher.cfg) wins over any manually-renamed build. Since
# 2026-08-23 repack writes a timestamped name per build and never the plain
# $MODFILE, so that tie-break is inert for the OneDrive folders and now only
# decides between same-second candidates. It is kept because Dev/ and the
# renamed backups can still carry the canonical name —
# otherwise .nasher/source, and thus a bare `nwn-manager repack`'s install
# target, can drift to whatever alt-named .mod happens to sort first. Builds go
# out to the Windows toolset via OneDrive and come back renamed by hand as
# point-in-time backups, so those renamed files stay selectable on mtime; the
# tie-break only decides between same-second candidates.
#
# The old rule hardcoded the literal "homers_lotr_v3.mod", which would silently
# stop matching from season 2 (homers_lotr_s2.mod) onward. It is now derived.
#
# The project root and $NWN_HOME_DIR/modules are NOT scanned: the repack archive
# lands in the project root on every build and would shadow an older OneDrive
# edit by mtime.
#
# Wiki regeneration is a separate step — use "Regenerate Homer's LotR Wiki".
#
# Options:
#   --verbose        Show full nwn-manager output (default: spinner + summary only)
#   --project DIR    Unpack a different season's repo (default: the newest repo)
#   --show-config    Print the resolved paths and exit without unpacking

set -o pipefail

VERBOSE=0
SHOW_CONFIG=0
REPACK_PROJECT=${NWN_PROJECT:-}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose) VERBOSE=1 ;;
    --project)  REPACK_PROJECT=${2:?--project needs a directory}; shift ;;
    --project=*) REPACK_PROJECT=${1#*=} ;;
    --show-config) SHOW_CONFIG=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

NWN_MANAGER_BIN=/var/home/james/GIT/nwn_manager/bin

export PATH="$HOME/.nimble/bin:$NWN_MANAGER_BIN:$PATH"

# Resolve PROJECT / MODFILE / ONEDRIVE_MOD_DIR from the target repo's
# nasher.cfg + server.env — the same resolver the repack wrappers use, so both
# halves of the round-trip agree on where a season's builds live.
# shellcheck disable=SC1091
. "$NWN_MANAGER_BIN/repack-project.sh"
repack_resolve_project || { read -rp "Press Enter..."; exit 1; }

# Read locations come from the resolver (ONEDRIVE_MOD_DIRS): the season's own
# folder, plus $ONEDRIVE_ROOT/Dev on the dev realm only. Drop any that do not
# exist -- find would error on a missing path, and Dev/ is optional.
CANDIDATE_DIRS=()
for d in "${ONEDRIVE_MOD_DIRS[@]:-$ONEDRIVE_MOD_DIR}"; do
  [[ -d $d ]] && CANDIDATE_DIRS+=( "$d" )
done

if [[ $SHOW_CONFIG -eq 1 ]]; then
  echo "[unpack] resolved configuration:"
  repack_print_project
  echo "  scanning:"
  printf '    %s\n' "${CANDIDATE_DIRS[@]}"
  exit 0
fi

cd "$PROJECT" || { echo "missing project: $PROJECT"; read -rp "Press Enter..."; exit 1; }

# Bail before the find: with an empty argument list find scans the CWD, which is
# now $PROJECT -- and the project root is full of repack archives that would
# shadow any OneDrive build by mtime. Exactly what this script must never pick.
if [[ ${#CANDIDATE_DIRS[@]} -eq 0 ]]; then
  echo "error: none of this project's OneDrive folders exist:"
  printf "  %s\n" "${ONEDRIVE_MOD_DIRS[@]:-$ONEDRIVE_MOD_DIR}"
  echo
  echo "Is OneDrive mounted? Run with --show-config to check the resolved paths."
  read -rp "Press Enter..."; exit 1
fi

# Newest mtime wins; among files tied for newest, prefer the canonical artifact.
mapfile -t MOD_ENTRIES < <(
  find "${CANDIDATE_DIRS[@]}" -maxdepth 1 -name "*.mod" -type f -print0 2>/dev/null \
    | xargs -0 stat -c '%Y %n' 2>/dev/null \
    | sort -rn
)

MOD=""
if [[ ${#MOD_ENTRIES[@]} -gt 0 ]]; then
  top_mtime="${MOD_ENTRIES[0]%% *}"
  MOD="${MOD_ENTRIES[0]#* }"
  for entry in "${MOD_ENTRIES[@]}"; do
    [[ "${entry%% *}" == "$top_mtime" ]] || break
    path="${entry#* }"
    if [[ $(basename "$path") == "$MODFILE" ]]; then
      MOD="$path"
      break
    fi
  done
fi

if [[ -z $MOD ]]; then
  echo "error: no .mod file found in:"
  printf "  %s\n" "${CANDIDATE_DIRS[@]}"
  echo
  echo "For a season whose first build hasn't run yet this is expected — the"
  echo "repack wrapper creates and populates that folder. Use --project DIR to"
  echo "target a different season's repo, or --show-config to check the paths."
  read -rp "Press Enter..."; exit 1
fi

echo "[unpack] reading: $MOD"
echo "[unpack] into:    $PROJECT/unpacked/"
echo

start=$(date +%s)

if [[ $VERBOSE -eq 1 ]]; then
  nwn-manager unpack "$MOD"
  status=$?
else
  tmpout=$(mktemp)
  trap 'rm -f "$tmpout"' EXIT

  nwn-manager unpack "$MOD" >"$tmpout" 2>&1 &
  bg_pid=$!
  spin='|/-\'
  si=0
  phase="starting"
  phase_order=0  # 0=starting 1=unpacking 2=converting 3=copying

  while kill -0 "$bg_pid" 2>/dev/null; do
    elapsed=$(( $(date +%s) - start ))

    if [[ $phase_order -lt 3 ]] && grep -qE "^\[nwn-manager\] copied" "$tmpout" 2>/dev/null; then
      phase="copying tlk"; phase_order=3
    elif [[ $phase_order -lt 2 ]] && grep -qE "^Converting " "$tmpout" 2>/dev/null; then
      n=$(grep -oE "Converting [0-9]+" "$tmpout" 2>/dev/null | grep -oE "[0-9]+" | head -1)
      phase="converting ${n:-?} files"; phase_order=2
    elif [[ $phase_order -lt 1 ]] && grep -qE "^\[nwn-manager\] unpacking" "$tmpout" 2>/dev/null; then
      phase="unpacking"; phase_order=1
    fi

    ch="${spin:$si:1}"; si=$(( (si + 1) % 4 ))
    printf "\r[unpack] %s %s  (%ds)          " "$ch" "$phase" "$elapsed"
    sleep 0.3
  done

  wait "$bg_pid"
  status=$?
  elapsed=$(( $(date +%s) - start ))
  printf "\r[unpack] done in %ds          \n" "$elapsed"

  if [[ $status -ne 0 ]]; then
    echo
    if [[ -s "$tmpout" ]]; then
      cat "$tmpout"
    else
      echo "[diagnostic] nwn-manager exited $status with no output"
      echo "             Try running with --verbose for full output, or check:"
      echo "               PATH=\$HOME/.nimble/bin:$NWN_MANAGER_BIN:\$PATH \\"
      echo "               nwn-manager unpack \"$MOD\" 2>&1 | head -30"
    fi
  else
    sed -n '/^\[nwn-manager\] unpacked\/ summary:/,$ p' "$tmpout"
  fi
fi

echo
if [[ $status -eq 0 ]]; then
  echo "[done] unpacked → $PROJECT/unpacked/"
  echo "       Run 'Regenerate Homer's LotR Wiki' to rebuild docs."
else
  echo "[FAILED] exit $status"
fi
echo
read -rp "Press Enter to close..."
