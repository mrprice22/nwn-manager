#!/usr/bin/env python3
"""nwn-fork-diff — compare ancestor module forks against a baseline module.

Produces a content-migration worklist: what the ancestors have that the
baseline lost, what the baseline has but orphaned, and how shared content
diverged.

Reads each module's pre-generated ``module-index/*.json`` (names there are
already TLK-resolved) plus its ``unpacked/*.json`` GFF (for tags and deep
fields the indexes don't carry).  Writes ``fork_diff.json`` + ``fork_diff.md``
into the baseline's ``module-index/``.

    nwn-fork-diff \
        --fork     /path/to/nwn_lordoftherings \
        --fork     /path/to/nwn_homers_lotr_2009 \
        --baseline /path/to/nwn_homers_lotr

The hard part is identity: resref is *not* stable across these forks.  Roughly
8-10% of shared resrefs were repurposed to entirely different content, and half
the areas that look deleted were merely re-resref'd.  So every axis runs on top
of `resolve_identity`, which matches resref -> tag -> name -> fuzzy and records
which rule fired.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import difflib
import hashlib
import json
import math
import re
import sys
from pathlib import Path
from typing import Any, Iterable

DATA_DIR = Path(__file__).resolve().parent / "wiki_data"


# ---------------------------------------------------------------------------
# GFF helpers (mirrors bin/nwn-wiki:113 — copied rather than imported because
# nwn-wiki has no .py extension and 17k lines of import-time side effects)
# ---------------------------------------------------------------------------

def gff(node: Any, default: Any = None) -> Any:
    """Unwrap a {'type': ..., 'value': ...} cell to its value."""
    if isinstance(node, dict) and "value" in node:
        return node["value"]
    return default if node is None else node


def fld(struct: dict | None, name: str, default: Any = None) -> Any:
    """Look up a named field's *value* in a GFF struct/dict."""
    if not struct or name not in struct:
        return default
    return gff(struct[name], default)


# ---------------------------------------------------------------------------
# Item property rendering — a compact subset of nwn-wiki's itemprop_format.
# Enough to make a property delta readable; falls back to raw numbers.
# ---------------------------------------------------------------------------

def _load_itemprops() -> tuple[dict[int, dict], dict[str, dict]]:
    p = DATA_DIR / "itemprops.json"
    if not p.exists():
        return {}, {}
    d = json.loads(p.read_text())
    return ({int(k): v for k, v in d.get("properties", {}).items()},
            d.get("tables", {}))


IPROP_DEFS, IPROP_TABLES = _load_itemprops()


def _table_lookup(table_name: str | None, idx: int | None) -> str | None:
    """Resolve a numeric index to a label: explicit row, then '_format'."""
    if not table_name or idx is None:
        return None
    tbl = IPROP_TABLES.get(table_name)
    if not isinstance(tbl, dict):
        return None
    row = tbl.get(str(idx))
    if isinstance(row, str):
        return row
    fmt = tbl.get("_format")
    if isinstance(fmt, str):
        return fmt.format(idx)
    return None


def itemprop_label(prop: dict) -> str:
    """Compact single-line label for one PropertiesList entry."""
    pid = fld(prop, "PropertyName")
    sub = fld(prop, "Subtype")
    cost = fld(prop, "CostValue")
    pdef = IPROP_DEFS.get(int(pid), {}) if pid is not None else {}
    bits = [pdef.get("name") or (f"Property #{pid}" if pid is not None else "?")]
    st = _table_lookup(pdef.get("subtype"), sub)
    if st:
        bits.append(st)
    elif sub:
        bits.append(f"subtype {sub}")
    cs = _table_lookup(pdef.get("cost_table"), cost)
    if cs:
        bits.append(cs)
    elif cost:
        bits.append(str(cost))
    return " ".join(bits)


# ---------------------------------------------------------------------------
# Name normalization
# ---------------------------------------------------------------------------

_MARKUP = re.compile(r"<[^>]*>")


def strip_markup(s: str | None) -> str:
    """Drop NWN <c???>/</c> colour codes and surrounding whitespace."""
    return _MARKUP.sub("", s or "").strip()


def norm_name(s: str | None) -> str:
    """Lowercase, markup-free, alphanumerics only — the name-match key."""
    return re.sub(r"[^a-z0-9]+", "", strip_markup(s).lower())


# ---------------------------------------------------------------------------
# Noise classification
# ---------------------------------------------------------------------------

STOCK_PREFIXES = ("nw_", "x0_", "x1_", "x2_", "x3_", "zep_", "ld_", "cep_")

_SCAFFOLD_NAME = re.compile(
    r"^(base\s|test\s|test$|wings?[ _/]?tail)|(\bmodifier$)|(\bproperties$)",
    re.I,
)


def classify_noise(kind: str, ent: dict) -> str | None:
    """Return a noise bucket for stock/scaffolding content, else None.

    These dominate the raw absent-pool and nobody wants them migrated, but we
    classify rather than drop so the counts stay auditable.
    """
    resref = (ent.get("resref") or "").lower()
    name = strip_markup(ent.get("name"))
    if resref.startswith(STOCK_PREFIXES):
        return "summon_blueprint" if resref.startswith("nw_s_") else "stock_blueprint"
    if kind == "item" and (ent.get("base_item") or "").lower().startswith("creature"):
        return "creature_item"
    if _SCAFFOLD_NAME.search(name):
        return "scaffolding"
    return None


# ---------------------------------------------------------------------------
# Autonumbered resrefs — the toolset assigns these, so they are not identity
# ---------------------------------------------------------------------------

# 'areaNNN' is what the New Area Wizard mints; '<stem>NNN' / '<stem>_N' is what
# palette copy-paste mints for creatures and items.  Two modules agreeing on
# such a resref is a collision, not evidence of shared identity — and two
# modules disagreeing on one is not evidence of lost content.  Names are the
# authority; these get demoted wherever a finding rests on the resref alone.
_AUTONUM_AREA = re.compile(r"^area\d+$", re.I)
_AUTONUM_COPY = re.compile(r"^(?P<stem>.*?)(?:_?\d{2,3})$")


def is_autonumbered(kind: str, resref: str) -> bool:
    rr = (resref or "").lower()
    if kind == "area":
        return bool(_AUTONUM_AREA.match(rr))
    m = _AUTONUM_COPY.match(rr)
    return bool(m and len(m.group("stem")) >= 3)


# ---------------------------------------------------------------------------
# Module loading
# ---------------------------------------------------------------------------

# entity kind -> docs/<section>/ directory holding its published pages
DOC_SECTION = {"area": "areas", "creature": "creatures", "item": "items",
               "conversation": "conversations", "store": "stores"}

# Every URL Module.page_url has existence-checked.  render_html refuses to emit
# an href that is not in here, which is what makes "zero dead links" a build
# guarantee rather than an aspiration.
VERIFIED_URLS: set[str] = set()


class Module:
    """One module repo: its module-index reports plus extracted GFF fields."""

    def __init__(self, root: Path, wiki_base: str, label: str | None = None) -> None:
        self.root = root
        self.index_dir = root / "module-index"
        self.unpacked = root / "unpacked"
        self.docs_dir = root / "docs"
        if not self.index_dir.is_dir():
            raise SystemExit(f"no module-index/ in {root} — run the wiki build there first")
        if not self.unpacked.is_dir():
            raise SystemExit(f"no unpacked/ in {root}")
        self.wiki_base = wiki_base.rstrip("/") + "/"
        self.docs_pages = self._scan_docs_pages()
        self.title = self._index("area_index.json").get("module") or root.name
        self.label = label or root.name
        self.wiki_label = root.name  # replaced with a short label once linked
        self._gff_cache: dict[str, dict[str, dict]] = {}
        self._dialogs: dict[str, dict] | None = None
        self.areas = self._load_areas()
        self.creatures = self._load_creatures()
        self.items = self._load_items()
        # Name-level rollups.  A single blueprint being unplaced/unreachable is
        # not evidence the *content* is gone: these modules routinely carry
        # several blueprints of the same name (baseline has two "Gandalf the
        # Gray", one placed and one not), and identity resolution consumes each
        # baseline entity once, so a fork entity can land on the dead twin.
        self.placed_names = {norm_name(c["name"]) for c in self.creatures.values()
                             if c["placed"] and norm_name(c["name"])}
        self.accessible_names = {norm_name(i["name"]) for i in self.items.values()
                                 if i["accessible"] and norm_name(i["name"])}
        self.reachable_area_names = {norm_name(a["name"]) for a in self.areas.values()
                                     if a["inbound"] > 0 and norm_name(a["name"])}

    # -- published wiki pages ---------------------------------------------

    def _scan_docs_pages(self) -> dict[str, set[str]]:
        """Page stems that actually exist under docs/<section>/.

        This is the *only* source of link truth.  The `wiki_url` fields in
        module-index are not usable — a wiki build without --base-url writes
        absolute local paths into every one of them — and they are also emitted
        for pages the build then skips (hidden areas), so trusting them yields
        404s.  Scanning the built tree instead handles the `__vN` variant stems
        and the hidden-area gaps for free.
        """
        out: dict[str, set[str]] = {}
        for section in ("areas", "creatures", "items", "conversations", "stores"):
            d = self.docs_dir / section
            out[section] = ({p.stem.lower() for p in d.glob("*.html")}
                            if d.is_dir() else set())
        return out

    def page_url(self, kind: str, resref: str) -> str:
        """Public URL for an entity's wiki page, or '' if this module has none."""
        section = DOC_SECTION.get(kind)
        if not section or not resref:
            return ""
        if resref.lower() not in self.docs_pages.get(section, ()):
            return ""
        url = f"{self.wiki_base}{section}/{resref.lower()}.html"
        VERIFIED_URLS.add(url)
        return url

    # -- raw report access ------------------------------------------------

    def _index(self, name: str) -> dict:
        p = self.index_dir / name
        if not p.exists():
            return {}
        return json.loads(p.read_text())

    # -- GFF extraction ---------------------------------------------------

    def _gff(self, ext: str, extract) -> dict[str, dict]:
        """Read every unpacked/*.<ext>.json once, keeping only what we need."""
        if ext in self._gff_cache:
            return self._gff_cache[ext]
        out: dict[str, dict] = {}
        for p in sorted(self.unpacked.glob(f"*.{ext}.json")):
            resref = p.name[: -len(f".{ext}.json")].lower()
            try:
                d = json.loads(p.read_text())
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            out[resref] = extract(d)
        self._gff_cache[ext] = out
        return out

    @staticmethod
    def _extract_utc(d: dict) -> dict:
        classes = sorted(
            (fld(c, "Class"), fld(c, "ClassLevel"))
            for c in (fld(d, "ClassList") or [])
        )
        return {
            "tag": fld(d, "Tag", ""),
            "natural_ac": fld(d, "NaturalAC"),
            "classes": classes,
            "feat_count": len(fld(d, "FeatList") or []),
            "conversation": fld(d, "Conversation", ""),
            "equip": sorted(
                str(fld(e, "EquippedRes", "")).lower()
                for e in (fld(d, "Equip_ItemList") or [])
            ),
            "inventory": sorted(
                str(fld(e, "InventoryRes", "")).lower()
                for e in (fld(d, "ItemList") or [])
            ),
            "scripts": {k: fld(d, k, "") for k in d if k.startswith("Script")},
        }

    @staticmethod
    def _extract_uti(d: dict) -> dict:
        props = []
        for p in fld(d, "PropertiesList") or []:
            props.append((
                fld(p, "PropertyName"), fld(p, "Subtype"),
                fld(p, "CostTable"), fld(p, "CostValue"), fld(p, "Param1Value"),
                itemprop_label(p),
            ))
        return {
            "tag": fld(d, "Tag", ""),
            "cost": fld(d, "Cost"),
            "add_cost": fld(d, "AddCost"),
            "charges": fld(d, "Charges"),
            "stack": fld(d, "StackSize"),
            "plot": fld(d, "Plot"),
            "cursed": fld(d, "Cursed"),
            "props": props,
        }

    @staticmethod
    def _extract_are(d: dict) -> dict:
        return {
            "tag": fld(d, "Tag", ""),
            "tileset": fld(d, "Tileset", ""),
            "width": fld(d, "Width"),
            "height": fld(d, "Height"),
            "scripts": {k: fld(d, k, "") for k in
                        ("OnEnter", "OnExit", "OnHeartbeat", "OnUserDefined")},
        }

    # -- normalized entity tables ----------------------------------------

    def _load_areas(self) -> dict[str, dict]:
        graph = self._index("area_graph.json").get("areas", {})
        inbound: dict[str, int] = {}
        for src, node in graph.items():
            for t in node.get("transitions", []):
                if t.get("to"):
                    inbound[t["to"]] = inbound.get(t["to"], 0) + 1
        gffs = self._gff("are", self._extract_are)
        out = {}
        for a in self._index("area_index.json").get("areas", []):
            rr = a["resref"].lower()
            g = gffs.get(rr, {})
            node = graph.get(rr, {})
            out[rr] = {
                "kind": "area", "resref": rr, "name": a.get("name", ""),
                "tag": g.get("tag", ""),
                "creature_count": a.get("creature_count", 0),
                "encounter_count": a.get("encounter_count", 0),
                "store_count": a.get("store_count", 0),
                "container_count": a.get("container_count", 0),
                "hidden": a.get("hidden", False),
                "outbound": len(node.get("transitions", [])),
                "inbound": inbound.get(rr, 0),
                "transitions": sorted({t.get("to", "") for t in node.get("transitions", [])}),
                "tileset": g.get("tileset", ""),
                "width": g.get("width"), "height": g.get("height"),
                "scripts": g.get("scripts", {}),
            }
        return out

    def _load_creatures(self) -> dict[str, dict]:
        unspawned = {c["canonical_resref"].lower()
                     for c in self._index("unspawned_creatures.json").get("creatures", [])}
        gffs = self._gff("utc", self._extract_utc)
        out = {}
        for c in self._index("creature_index.json").get("creatures", []):
            rr = (c.get("canonical_resref") or c.get("resref") or "").lower()
            if not rr:
                continue
            g = gffs.get(rr) or gffs.get((c.get("resref") or "").lower(), {})
            locs = c.get("locations", [])
            out[rr] = {
                "kind": "creature", "resref": rr, "name": c.get("name", ""),
                "tag": g.get("tag", ""),
                "cr": _num(c.get("cr")), "hp": c.get("hp"),
                "race": c.get("race", ""), "faction": c.get("faction_name", ""),
                "appearance": c.get("appearance_name", ""),
                "locations": locs,
                "placements": sum(l.get("count", 1) for l in locs),
                "placed": rr not in unspawned,
                "classes": g.get("classes", []),
                "natural_ac": g.get("natural_ac"),
                "feat_count": g.get("feat_count"),
                "conversation": g.get("conversation", ""),
                "scripts": g.get("scripts", {}),
                "equip": g.get("equip", []),
                "inventory": g.get("inventory", []),
            }
        return out

    def _load_items(self) -> dict[str, dict]:
        inacc = {i["resref"].lower(): i
                 for i in self._index("inaccessible_items.json").get("items", [])}
        gffs = self._gff("uti", self._extract_uti)
        out = {}
        for i in self._index("item_index.json").get("items", []):
            rr = i["resref"].lower()
            g = gffs.get(rr, {})
            out[rr] = {
                "kind": "item", "resref": rr, "name": i.get("name", ""),
                "tag": g.get("tag", ""),
                "base_item": i.get("base_item", ""),
                "cost_gp": i.get("cost_gp", 0),
                "accessible": bool(i.get("accessible")),
                "sources": i.get("sources", []),
                "inaccessible_reason": (inacc.get(rr) or {}).get("reason", ""),
                "props": g.get("props", []),
                "cost": g.get("cost"), "add_cost": g.get("add_cost"),
                "plot": g.get("plot"), "cursed": g.get("cursed"),
            }
        return out

    # -- scripts & dialogs ------------------------------------------------

    def script_hashes(self) -> dict[str, tuple[str, int]]:
        """resref -> (hash of comment-stripped normalized source, line count)."""
        out = {}
        for p in sorted(self.unpacked.glob("*.nss")):
            text = p.read_text(encoding="utf-8", errors="replace")
            body = re.sub(r"//[^\n]*|/\*.*?\*/", "", text, flags=re.S)
            body = re.sub(r"\s+", " ", body).strip()
            out[p.stem.lower()] = (hashlib.sha1(body.encode()).hexdigest(),
                                   text.count("\n") + 1)
        return out

    def script_source(self, resref: str) -> str:
        p = self.unpacked / f"{resref}.nss"
        return p.read_text(encoding="utf-8", errors="replace") if p.exists() else ""

    @staticmethod
    def _locstring(node: dict | None) -> str:
        """First localized string out of a CExoLocString cell."""
        v = gff(node) if node is not None else None
        if isinstance(v, str):
            return v
        if isinstance(v, dict):
            for k in sorted(v):
                if isinstance(v[k], str) and v[k].strip():
                    return v[k]
        return ""

    def dialogs(self) -> dict[str, dict]:
        """resref -> node counts, an ordered transcript, and its hash.

        The old version kept only three integers, so a conversation whose text
        was rewritten wholesale but kept its shape was invisible, and a
        conversation that merely moved to a new resref looked dropped.  The
        transcript fixes both and is what the report diffs.
        """
        if self._dialogs is not None:
            return self._dialogs
        out: dict[str, dict] = {}
        for p in sorted(self.unpacked.glob("*.dlg.json")):
            try:
                d = json.loads(p.read_text())
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            nodes: list[dict] = []
            scripts: set[str] = set()
            for role, key in (("NPC", "EntryList"), ("PC", "ReplyList")):
                for i, n in enumerate(fld(d, key) or []):
                    text = self._locstring(n.get("Text"))
                    act, cond = fld(n, "Script", ""), fld(n, "Active", "")
                    quest = fld(n, "Quest", "")
                    scripts.update(s for s in (act, cond) if s)
                    nodes.append({
                        "role": role, "index": i, "text": strip_markup(text),
                        "speaker": fld(n, "Speaker", ""),
                        "script": act, "active": cond, "quest": quest,
                    })
            transcript = [f"{n['role']} {n['index']}: {n['text']}" for n in nodes]
            out[p.name[: -len(".dlg.json")].lower()] = {
                "entries": len(fld(d, "EntryList") or []),
                "replies": len(fld(d, "ReplyList") or []),
                "starts": len(fld(d, "StartingList") or []),
                "nodes": nodes,
                "scripts": sorted(scripts),
                "transcript": transcript,
                "text_hash": hashlib.sha1(
                    "\n".join(n["text"] for n in nodes).encode()).hexdigest(),
            }
        self._dialogs = out
        return out

    def dialog_owners(self) -> dict[str, list[dict]]:
        """conversation resref -> the creatures that use it, and where they stand."""
        out: dict[str, list[dict]] = {}
        for rr, c in self.creatures.items():
            conv = (c.get("conversation") or "").lower()
            if not conv:
                continue
            out.setdefault(conv, []).append({
                "resref": rr, "name": strip_markup(c["name"]),
                "areas": sorted({l.get("area_name", "") for l in c["locations"] if l.get("area_name")}),
                "placed": c["placed"],
            })
        for v in out.values():
            v.sort(key=lambda c: c["name"])
        return out

    # -- cross-module wiki links -----------------------------------------

    def table_for(self, kind: str) -> dict[str, dict]:
        if kind == "conversation":
            return self.dialogs()
        return {"area": self.areas, "creature": self.creatures,
                "item": self.items}[kind]

    def by_norm_name(self, kind: str) -> dict[str, list[str]]:
        """normalized name -> resrefs, for cross-module lookup by name."""
        cache = getattr(self, "_name_cache", None)
        if cache is None:
            cache = self._name_cache = {}
        if kind not in cache:
            idx: dict[str, list[str]] = {}
            for rr, e in self.table_for(kind).items():
                n = norm_name(e.get("name"))
                if n:
                    idx.setdefault(n, []).append(rr)
            for v in idx.values():
                v.sort()
            cache[kind] = idx
        return cache[kind]


def short_wiki_label(mod: Module, is_baseline: bool) -> str:
    """A compact name for a module's wiki, taken from its published host."""
    if is_baseline:
        return "live"
    m = re.match(r"https?://([^./]+)\.", mod.wiki_base)
    if m:
        return "2008" if m.group(1) == "lotr" else m.group(1)
    return mod.root.name


def wiki_links(pairs: list[tuple[Module, str, str]], kind: str) -> list[dict]:
    """Build a chip per module: {label, url, present, resref}.

    Fork and baseline resrefs differ for renamed content, so each module is
    looked up with *its own* resref rather than a shared one.  Modules where
    the entity has no page still get a chip, with ``present: False`` — the
    *absence* of a link is the finding ("this does not exist over there"), so
    it has to be rendered rather than silently omitted.
    """
    out, seen = [], set()
    for mod, resref, label in pairs:
        if label in seen:
            continue
        seen.add(label)
        url = mod.page_url(kind, resref) if resref else ""
        out.append({"label": label, "url": url, "present": bool(url),
                    "resref": (resref or "").lower()})
    return out


# (baseline, [(label, fork_module), ...]) — set once by main(), so every finding
# can be given a chip for *every* module rather than only the ones it came from.
ALL_MODULES: list[tuple[str, Module]] = []


def entity_chips(kind: str, resrefs: dict[str, str], name: str = "") -> list[dict]:
    """One chip per known module, resolving by resref then by name.

    ``resrefs`` maps a module's wiki label to the resref that module uses for
    this entity, where it is known.  Where it is not, we fall back to a
    name lookup in that module, so a chip only comes out absent when the entity
    genuinely has no page there.
    """
    pairs = []
    for label, mod in ALL_MODULES:
        rr = (resrefs.get(label) or "").lower()
        if not rr and name:
            cands = mod.by_norm_name(kind).get(norm_name(name)) or []
            rr = cands[0] if cands else ""
        pairs.append((mod, rr, label))
    return wiki_links(pairs, kind)


def merge_links(rec: dict, extra: list[dict]) -> None:
    """Add chips for modules not already represented, upgrading absent→present."""
    by_label = {l["label"]: l for l in rec.setdefault("wiki_links", [])}
    for l in extra:
        cur = by_label.get(l["label"])
        if cur is None:
            rec["wiki_links"].append(l)
            by_label[l["label"]] = l
        elif l["present"] and not cur["present"]:
            cur.update(l)


def _num(v: Any) -> float:
    try:
        return float(v)
    except (TypeError, ValueError):
        return 0.0


# ---------------------------------------------------------------------------
# Component 1 — identity resolution
# ---------------------------------------------------------------------------

# ratio >= CUTOFF implies max_len <= min_len * (2/CUTOFF - 1); used to skip
# hopeless candidates before paying for SequenceMatcher.
FUZZY_CUTOFF = 0.82
_LEN_BOUND = 2.0 / FUZZY_CUTOFF - 1.0


def resolve_identity(fork: dict[str, dict], base: dict[str, dict],
                     *, fuzzy: bool = True) -> dict[str, dict]:
    """Match every fork entity to at most one baseline entity.

    Tries resref, then tag, then normalized name, then fuzzy name.  Each
    baseline entity is consumed once.  Returns {fork_resref: {match_kind,
    base_resref}} with match_kind 'none' when nothing matched.
    """
    matches: dict[str, dict] = {}
    consumed: set[str] = set()

    # 1. resref
    for rr in fork:
        if rr in base:
            matches[rr] = {"match_kind": "resref", "base_resref": rr}
            consumed.add(rr)

    remaining = [rr for rr in fork if rr not in matches]

    # 2. tag — only when the tag identifies exactly one entity on *both*
    #    sides.  Area tags in particular are heavily duplicated ('Area001' is
    #    shared by six areas), so an ambiguous tag is worse than no tag.
    base_by_tag: dict[str, list[str]] = {}
    for rr, e in base.items():
        if e.get("tag"):
            base_by_tag.setdefault(e["tag"].lower(), []).append(rr)
    fork_tag_counts: dict[str, int] = {}
    for rr in remaining:
        t = (fork[rr].get("tag") or "").lower()
        if t:
            fork_tag_counts[t] = fork_tag_counts.get(t, 0) + 1
    for rr in remaining:
        t = (fork[rr].get("tag") or "").lower()
        if not t or fork_tag_counts.get(t, 0) != 1:
            continue
        cands = base_by_tag.get(t, [])
        if len(cands) == 1 and cands[0] not in consumed:
            matches[rr] = {"match_kind": "tag", "base_resref": cands[0]}
            consumed.add(cands[0])

    remaining = [rr for rr in fork if rr not in matches]

    # 3. exact normalized name
    base_by_name: dict[str, list[str]] = {}
    for rr, e in base.items():
        base_by_name.setdefault(norm_name(e.get("name")), []).append(rr)
    for rr in sorted(remaining):
        n = norm_name(fork[rr].get("name"))
        if not n:
            continue
        for cand in sorted(base_by_name.get(n, [])):
            if cand not in consumed:
                matches[rr] = {"match_kind": "name", "base_resref": cand}
                consumed.add(cand)
                break

    remaining = [rr for rr in fork if rr not in matches]

    # 4. fuzzy name over what's left
    if fuzzy:
        pool = [(norm_name(base[rr].get("name")), rr)
                for rr in base if rr not in consumed and norm_name(base[rr].get("name"))]
        by_len: dict[int, list[tuple[str, str]]] = {}
        for n, rr in pool:
            by_len.setdefault(len(n), []).append((n, rr))
        for rr in sorted(remaining):
            n = norm_name(fork[rr].get("name"))
            if not n:
                continue
            lo, hi = math.ceil(len(n) / _LEN_BOUND), math.floor(len(n) * _LEN_BOUND)
            best, best_rr = 0.0, None
            for ln in range(lo, hi + 1):
                for cn, crr in by_len.get(ln, []):
                    if crr in consumed:
                        continue
                    ratio = difflib.SequenceMatcher(None, n, cn).ratio()
                    if ratio > best:
                        best, best_rr = ratio, crr
            if best_rr and best >= FUZZY_CUTOFF:
                matches[rr] = {"match_kind": "fuzzy", "base_resref": best_rr,
                               "similarity": round(best, 3)}
                consumed.add(best_rr)

    for rr in fork:
        matches.setdefault(rr, {"match_kind": "none", "base_resref": None})
    return matches


# ---------------------------------------------------------------------------
# Component 2 — lost content to reclaim
# ---------------------------------------------------------------------------

def reclaim_score(kind: str, e: dict) -> float:
    """Rough 'how much content comes back if we reclaim this' weight."""
    if kind == "area":
        return (e["creature_count"] * 3 + e["encounter_count"] * 2
                + e["store_count"] * 5 + e["container_count"] * 2 + e["inbound"])
    if kind == "creature":
        return (e["placements"] * 4 + min(e["cr"], 100) / 10
                + (3 if e.get("conversation") else 0))
    # item
    return ((10 if e["accessible"] else 0)
            + min(e.get("cost_gp") or 0, 5_000_000) / 500_000)


def lost_content(forks: list[tuple[str, Module]], base: Module,
                 resolved: dict, include_stock: bool) -> dict:
    """Fork entities that resolved to nothing in the baseline."""
    out: dict[str, list] = {"areas": [], "creatures": [], "items": []}
    noise: dict[str, int] = {}
    seen: dict[str, set] = {"areas": set(), "creatures": set(), "items": set()}

    for label, mod in forks:
        for kind, plural, table in (("area", "areas", mod.areas),
                                    ("creature", "creatures", mod.creatures),
                                    ("item", "items", mod.items)):
            for rr, e in table.items():
                if resolved[label][plural][rr]["match_kind"] != "none":
                    continue
                bucket = classify_noise(kind, e)
                if bucket and not include_stock:
                    noise[bucket] = noise.get(bucket, 0) + 1
                    continue
                key = (rr, norm_name(e["name"]))
                if key in seen[plural]:
                    # already reported from an earlier fork; note the extra source
                    for rec in out[plural]:
                        if (rec["resref"], norm_name(rec["name"])) == key:
                            rec["forks"].append(label)
                            rec["fork_resrefs"][label] = rr
                            merge_links(rec, entity_chips(
                                kind, {label: rr}, rec["name"]))
                            break
                    continue
                seen[plural].add(key)
                rec = {
                    "resref": rr, "name": strip_markup(e["name"]), "tag": e["tag"],
                    "forks": [label], "fork_resrefs": {label: rr},
                    "score": round(reclaim_score(kind, e), 2),
                    "wiki_links": entity_chips(kind, {label: rr},
                                               strip_markup(e["name"])),
                }
                if bucket:
                    rec["noise_bucket"] = bucket
                if kind == "area":
                    rec.update({
                        "creature_count": e["creature_count"],
                        "encounter_count": e["encounter_count"],
                        "store_count": e["store_count"],
                        "container_count": e["container_count"],
                        "inbound": e["inbound"], "outbound": e["outbound"],
                        "tileset": e["tileset"],
                        "scripts": sorted({s for s in e["scripts"].values() if s}),
                        "contains": _area_manifest(mod, rr, label),
                    })
                elif kind == "creature":
                    rec.update({
                        "cr": e["cr"], "hp": e["hp"], "race": e["race"],
                        "faction": e["faction"], "placed": e["placed"],
                        "placements": e["placements"],
                        "areas": sorted({l.get("area_name", "") for l in e["locations"]}),
                        "conversation": e["conversation"],
                        "scripts": sorted({s for s in e["scripts"].values() if s}),
                    })
                else:
                    rec.update({
                        "base_item": e["base_item"], "cost_gp": e["cost_gp"],
                        "accessible_in_fork": e["accessible"],
                        "sources": e["sources"],
                        "properties": [p[5] for p in e["props"]],
                    })
                out[plural].append(rec)

    for plural in out:
        out[plural].sort(key=lambda r: (-r["score"], r["name"]))
    return {"noise_filtered": noise, **out}


def _area_manifest(mod: Module, area_rr: str, label: str) -> dict:
    """What a lost area contained, so reclaiming it pulls its content along."""
    creatures = []
    for rr, c in mod.creatures.items():
        for loc in c["locations"]:
            if (loc.get("area_resref") or "").lower() == area_rr:
                creatures.append({
                    "resref": rr, "name": strip_markup(c["name"]),
                    "cr": c["cr"], "count": loc.get("count", 1),
                    "wiki_links": entity_chips("creature", {label: rr},
                                               strip_markup(c["name"])),
                })
                break
    creatures.sort(key=lambda c: -c["cr"])
    return {"creatures": creatures}


# ---------------------------------------------------------------------------
# Component 3 — accessibility regressions
# ---------------------------------------------------------------------------

def _siblings(base: Module, kind: str, name: str, flag: str) -> list[dict]:
    """Every baseline blueprint sharing this name, with its own status.

    Answers the question a bare finding leaves open: "there are four Weathertop
    King blueprints — which one do I place?"
    """
    out = []
    for rr in base.by_norm_name(kind).get(norm_name(name), []):
        e = base.table_for(kind)[rr]
        out.append({
            "resref": rr, "ok": bool(e.get(flag)),
            "wiki_links": entity_chips(kind, {base.wiki_label: rr}, name),
        })
    return sorted(out, key=lambda s: (not s["ok"], s["resref"]))


def accessibility(forks: list[tuple[str, Module]], base: Module,
                  resolved: dict) -> dict:
    improved: list[dict] = []
    # keyed by baseline resref so a finding present in several forks is one row
    reg_by_rr: dict[str, dict] = {}
    orph_by_rr: dict[str, dict] = {}
    spawn_by_rr: dict[str, dict] = {}
    # Findings the name-level rollup demoted: the *content* is still live in the
    # baseline, just under a different blueprint of the same name.  Kept and
    # reported separately rather than dropped, so the reader can see why an
    # entry they expected is not in the real list.
    dup_reg: dict[str, dict] = {}
    dup_spawn: dict[str, dict] = {}
    dup_orph: dict[str, dict] = {}

    def _record(store: dict, key: str, seed: dict, label: str, fork_rr: str,
                match_kind: str) -> dict:
        rec = store.setdefault(key, seed)
        rec["forks"].append(label)
        rec["fork_resrefs"][label] = fork_rr
        rec["match_kinds"].append(match_kind)
        merge_links(rec, entity_chips(seed["kind"], {label: fork_rr}, rec["name"]))
        return rec

    for label, mod in forks:
        # items reachable in the fork, unreachable now
        for rr, e in mod.items.items():
            m = resolved[label]["items"][rr]
            if m["match_kind"] == "none":
                continue
            b = base.items[m["base_resref"]]
            name = strip_markup(b["name"])
            if e["accessible"] and not b["accessible"]:
                live = norm_name(name) in base.accessible_names
                seed = {
                    "kind": "item",
                    "resref": b["resref"], "name": name,
                    "forks": [], "fork_resrefs": {}, "match_kinds": [],
                    "base_item": b["base_item"], "cost_gp": b["cost_gp"],
                    "reason_now": b["inaccessible_reason"],
                    "sources_in_fork": [],
                    "siblings": _siblings(base, "item", name, "accessible"),
                    "wiki_links": entity_chips(
                        "item", {base.wiki_label: b["resref"]}, name),
                }
                rec = _record(dup_reg if live else reg_by_rr, b["resref"], seed,
                              label, rr, m["match_kind"])
                for s in e["sources"]:
                    if s not in rec["sources_in_fork"]:
                        rec["sources_in_fork"].append(s)
            elif not e["accessible"] and b["accessible"]:
                improved.append({"resref": b["resref"], "fork": label})

        # areas that had inbound transitions in the fork and have none now
        for rr, e in mod.areas.items():
            m = resolved[label]["areas"][rr]
            if m["match_kind"] == "none":
                continue
            b = base.areas[m["base_resref"]]
            name = strip_markup(b["name"])
            if e["inbound"] > 0 and b["inbound"] == 0:
                live = norm_name(name) in base.reachable_area_names
                seed = {
                    "kind": "area",
                    "resref": b["resref"], "name": name,
                    "forks": [], "fork_resrefs": {}, "match_kinds": [],
                    "inbound_in_fork": 0,
                    "creature_count": b["creature_count"],
                    "hidden": b.get("hidden", False),
                    "siblings": _siblings(base, "area", name, "inbound"),
                    "wiki_links": entity_chips(
                        "area", {base.wiki_label: b["resref"]}, name),
                }
                rec = _record(dup_orph if live else orph_by_rr, b["resref"], seed,
                              label, rr, m["match_kind"])
                rec["inbound_in_fork"] = max(rec["inbound_in_fork"], e["inbound"])

        # creatures placed in the fork, blueprint-only now
        for rr, e in mod.creatures.items():
            m = resolved[label]["creatures"][rr]
            if m["match_kind"] == "none":
                continue
            b = base.creatures[m["base_resref"]]
            name = strip_markup(b["name"])
            if e["placed"] and not b["placed"]:
                # The matched baseline blueprint is unplaced — but identity
                # resolution consumes each baseline entity once, so it may have
                # landed on the dead twin of a name that *is* placed elsewhere
                # (baseline carries two "Gandalf the Gray", one of each).  Only
                # a name with no placed blueprint at all is a real regression.
                live = norm_name(name) in base.placed_names
                seed = {
                    "kind": "creature",
                    "resref": b["resref"], "name": name,
                    "forks": [], "fork_resrefs": {}, "match_kinds": [],
                    "cr": b["cr"], "areas_in_fork": [],
                    "siblings": _siblings(base, "creature", name, "placed"),
                    "wiki_links": entity_chips(
                        "creature", {base.wiki_label: b["resref"]}, name),
                }
                rec = _record(dup_spawn if live else spawn_by_rr, b["resref"], seed,
                              label, rr, m["match_kind"])
                for a in sorted({l.get("area_name", "") for l in e["locations"]}):
                    if a and a not in rec["areas_in_fork"]:
                        rec["areas_in_fork"].append(a)

    regressed = sorted(reg_by_rr.values(), key=lambda r: -(r["cost_gp"] or 0))
    lost_spawns = sorted(spawn_by_rr.values(), key=lambda r: -r["cr"])
    orphaned_areas = sorted(orph_by_rr.values(), key=lambda r: -r["creature_count"])
    by_fork: dict[str, int] = {}
    for r in regressed:
        for f in r["forks"]:
            by_fork[f] = by_fork.get(f, 0) + 1

    return {
        "items_regressed": regressed,
        "items_regressed_by_fork": by_fork,
        "items_improved_count": len(improved),
        "areas_orphaned": orphaned_areas,
        "creatures_no_longer_spawned": lost_spawns,
        "items_regressed_dup": sorted(dup_reg.values(),
                                      key=lambda r: -(r["cost_gp"] or 0)),
        "creatures_spawned_elsewhere": sorted(dup_spawn.values(),
                                              key=lambda r: -r["cr"]),
        "areas_orphaned_dup": sorted(dup_orph.values(),
                                     key=lambda r: -r["creature_count"]),
    }


# ---------------------------------------------------------------------------
# Component 4 — diverged shared content
# ---------------------------------------------------------------------------

def _delta(a: dict, b: dict, fields: Iterable[str]) -> dict:
    out = {}
    for f in fields:
        if a.get(f) != b.get(f):
            out[f] = {"fork": a.get(f), "baseline": b.get(f)}
    return out


def divergence(forks: list[tuple[str, Module]], base: Module,
               resolved: dict, include_stock: bool) -> dict:
    rebalanced: list[dict] = []
    # keyed by (kind, resref, fork name) so the same repurposing seen in two
    # forks is one row listing both, not two near-identical rows
    repurp_by_key: dict[tuple, dict] = {}

    for label, mod in forks:
        for plural, table, btable, fields in (
            ("creatures", mod.creatures, base.creatures,
             ("cr", "hp", "race", "faction", "appearance", "natural_ac",
              "classes", "feat_count", "conversation")),
            ("items", mod.items, base.items,
             ("base_item", "cost_gp", "add_cost", "plot", "cursed")),
            ("areas", mod.areas, base.areas,
             ("tileset", "width", "height")),
        ):
            kind = plural[:-1]
            for rr, e in table.items():
                m = resolved[label][plural][rr]
                if m["match_kind"] == "none":
                    continue
                if not include_stock and classify_noise(kind, e):
                    continue
                b = btable[m["base_resref"]]
                same_name = norm_name(e["name"]) == norm_name(b["name"])

                if m["match_kind"] == "resref" and not same_name:
                    key = (kind, rr, norm_name(e["name"]))
                    rec = repurp_by_key.setdefault(key, {
                        "kind": kind, "resref": rr, "forks": [],
                        "fork_name": strip_markup(e["name"]),
                        "baseline_name": strip_markup(b["name"]),
                        "fork_tag": e["tag"], "baseline_tag": b["tag"],
                        # A shared 'areaNNN' / '<stem>NNN' resref is the toolset
                        # numbering two unrelated things the same, not a slot
                        # anybody deliberately reused.
                        "autonumbered": is_autonumbered(kind, rr),
                        "wiki_links": entity_chips(
                            kind, {base.wiki_label: b["resref"], label: rr}),
                    })
                    rec["forks"].append(label)
                    merge_links(rec, entity_chips(kind, {label: rr}))
                    continue

                d = _delta(e, b, fields)
                if plural == "items":
                    fp = {p[:5] for p in e["props"]}
                    bp = {p[:5] for p in b["props"]}
                    if fp != bp:
                        flab = {p[:5]: p[5] for p in e["props"]}
                        blab = {p[:5]: p[5] for p in b["props"]}
                        d["properties"] = {
                            "removed": sorted(flab[k] for k in fp - bp),
                            "added": sorted(blab[k] for k in bp - fp),
                        }
                elif plural == "areas":
                    ft, bt = set(e["transitions"]), set(b["transitions"])
                    if ft != bt:
                        d["transitions"] = {"removed": sorted(ft - bt),
                                            "added": sorted(bt - ft)}
                if not d:
                    continue
                rec = {
                    "kind": kind, "fork": label, "fork_resref": rr,
                    "resref": b["resref"], "match_kind": m["match_kind"],
                    "name": strip_markup(b["name"]), "changes": d,
                    "wiki_links": entity_chips(
                        kind, {base.wiki_label: b["resref"], label: rr},
                        strip_markup(b["name"])),
                }
                if not same_name:
                    rec["fork_name"] = strip_markup(e["name"])
                rebalanced.append(rec)

    repurposed = sorted(repurp_by_key.values(), key=lambda r: (r["kind"], r["resref"]))
    rebalanced.sort(key=lambda r: (r["kind"], -len(r["changes"]), r["name"]))
    by_kind: dict[str, list[dict]] = {}
    for r in rebalanced:
        by_kind.setdefault(r["kind"], []).append(r)
    return {
        "repurposed": [r for r in repurposed if not r["autonumbered"]],
        "repurposed_autonumbered": [r for r in repurposed if r["autonumbered"]],
        "rebalanced": rebalanced,
        "rebalanced_by_kind": by_kind,
        "by_name": name_divergence(forks, base, include_stock),
    }


def name_divergence(forks: list[tuple[str, Module]], base: Module,
                    include_stock: bool) -> dict:
    """The same comparison keyed on *names* rather than resrefs.

    resrefs are the wrong axis for "what changed": the toolset autonumbers area
    and copy-paste resrefs, so two modules can hold the same content under
    different resrefs and different content under the same one.  Keyed on name,
    the three interesting buckets fall out cleanly per kind: content that
    survived under a new resref, content only the fork has, and content only the
    baseline has — and the resref pair is then reported as *supporting detail*
    ("was X, is now Y") rather than as the thing being matched on.
    """
    out: dict[str, dict] = {}
    for kind in ("area", "creature", "item"):
        btable = base.table_for(kind)
        bnames = base.by_norm_name(kind)
        renamed: list[dict] = []
        only_fork: dict[str, dict] = {}
        seen_names: set[str] = set()

        for label, mod in forks:
            for rr, e in mod.table_for(kind).items():
                if not include_stock and classify_noise(kind, e):
                    continue
                n = norm_name(e["name"])
                if not n:
                    continue
                cands = bnames.get(n) or []
                if not cands:
                    rec = only_fork.setdefault(n, {
                        "kind": kind, "name": strip_markup(e["name"]),
                        "forks": [], "fork_resrefs": {},
                        "wiki_links": entity_chips(kind, {label: rr},
                                                   strip_markup(e["name"])),
                    })
                    rec["forks"].append(label)
                    rec["fork_resrefs"][label] = rr
                    merge_links(rec, entity_chips(kind, {label: rr}))
                elif rr not in btable:
                    # same name, different resref — survived, re-resref'd
                    renamed.append({
                        "kind": kind, "name": strip_markup(e["name"]),
                        "fork": label, "fork_resref": rr,
                        "baseline_resrefs": cands,
                        "autonumbered": (is_autonumbered(kind, rr)
                                         or all(is_autonumbered(kind, c) for c in cands)),
                        "wiki_links": entity_chips(
                            kind, {base.wiki_label: cands[0], label: rr},
                            strip_markup(e["name"])),
                    })
                seen_names.add(n)

        only_base = []
        for n, rrs in sorted(bnames.items()):
            if n in seen_names:
                continue
            e = btable[rrs[0]]
            if not include_stock and classify_noise(kind, e):
                continue
            only_base.append({
                "kind": kind, "name": strip_markup(e["name"]),
                "baseline_resrefs": rrs,
                "wiki_links": entity_chips(kind, {base.wiki_label: rrs[0]},
                                           strip_markup(e["name"])),
            })

        out[kind] = {
            "renamed": sorted(renamed, key=lambda r: r["name"].lower()),
            "only_in_fork": sorted(only_fork.values(), key=lambda r: r["name"].lower()),
            "only_in_baseline": sorted(only_base, key=lambda r: r["name"].lower()),
        }
    return out


# ---------------------------------------------------------------------------
# Component 5 — script & dialog divergence
# ---------------------------------------------------------------------------

def script_divergence(forks: list[tuple[str, Module]], base: Module,
                      lost: dict, max_diff_lines: int) -> dict:
    base_scripts = base.script_hashes()

    # scripts referenced by content we lost — reclaiming the content needs these
    wanted: dict[str, list[str]] = {}
    for plural in ("areas", "creatures"):
        for rec in lost.get(plural, []):
            for s in rec.get("scripts", []):
                wanted.setdefault(s.lower(), []).append(f"{plural[:-1]} {rec['name']}")
            conv = rec.get("conversation")
            if conv:
                wanted.setdefault(conv.lower(), []).append(f"{plural[:-1]} {rec['name']}")

    per_fork = {}
    dropped_all: dict[str, dict] = {}
    modified_all: dict[str, dict] = {}

    for label, mod in forks:
        fs = mod.script_hashes()
        common = set(fs) & set(base_scripts)
        dropped = sorted(set(fs) - set(base_scripts))
        modified = sorted(k for k in common if fs[k][0] != base_scripts[k][0])
        per_fork[label] = {
            "dropped": len(dropped), "modified": len(modified),
            "identical": len(common) - len(modified),
            "added_in_baseline": len(set(base_scripts) - set(fs)),
        }
        for k in dropped:
            rec = dropped_all.setdefault(k, {
                "resref": k, "forks": [], "lines": fs[k][1],
                "needed_by": wanted.get(k, []),
            })
            rec["forks"].append(label)
        for k in modified:
            rec = modified_all.setdefault(k, {
                "resref": k, "forks": [],
                "fork_lines": fs[k][1], "baseline_lines": base_scripts[k][1],
            })
            rec["forks"].append(label)
            if max_diff_lines and "diff" not in rec:
                d = list(difflib.unified_diff(
                    mod.script_source(k).splitlines(),
                    base.script_source(k).splitlines(),
                    fromfile=f"{label}/{k}.nss", tofile=f"baseline/{k}.nss",
                    lineterm="", n=2))
                rec["diff"] = d[:max_diff_lines]
                rec["diff_truncated"] = len(d) > max_diff_lines

    return {
        "summary": per_fork,
        "scripts_dropped": sorted(dropped_all.values(),
                                  key=lambda r: (not r["needed_by"], r["resref"])),
        "scripts_modified": sorted(modified_all.values(), key=lambda r: r["resref"]),
    }


# ---------------------------------------------------------------------------
# Component 6 — dialog divergence
# ---------------------------------------------------------------------------

def _owner_summary(owners: list[dict]) -> str:
    if not owners:
        return ""
    return "; ".join(
        f"{o['name']}" + (f" ({', '.join(o['areas'])})" if o["areas"] else "")
        for o in owners)


def dialog_divergence(forks: list[tuple[str, Module]], base: Module,
                      max_diff_lines: int) -> dict:
    """Conversations dropped, renamed, rewritten, or handed to a different NPC.

    Conversations are the module's actual writing, so they get treated as
    content rather than as a build artefact: the report carries who spoke each
    one and where, the full transcript of anything dropped (so it can be
    reclaimed straight off the page), and a real text diff of anything
    rewritten.  Node *counts* alone — the old comparison — miss a conversation
    whose every line was rewritten in place, and cry wolf over one that merely
    moved to a new resref.
    """
    base_dlgs = base.dialogs()
    base_owners = base.dialog_owners()
    base_by_hash: dict[str, list[str]] = {}
    for k, v in base_dlgs.items():
        base_by_hash.setdefault(v["text_hash"], []).append(k)

    summary: dict[str, dict] = {}
    renamed: dict[str, dict] = {}
    dropped: dict[str, dict] = {}
    changed: dict[str, dict] = {}
    owner_changed: dict[str, dict] = {}

    for label, mod in forks:
        fd = mod.dialogs()
        fork_owners = mod.dialog_owners()
        n_dropped = n_renamed = n_changed = 0

        for k, v in sorted(fd.items()):
            f_owners = fork_owners.get(k, [])
            if k not in base_dlgs:
                # Same text under a different resref is a rename, not a loss.
                twin = [t for t in base_by_hash.get(v["text_hash"], []) if t != k]
                if twin:
                    n_renamed += 1
                    rec = renamed.setdefault(k, {
                        "resref": k, "baseline_resref": twin[0], "forks": [],
                        "owners_in_fork": f_owners,
                        "nodes": v["entries"] + v["replies"],
                        "wiki_links": entity_chips(
                            "conversation", {base.wiki_label: twin[0], label: k}),
                    })
                    rec["forks"].append(label)
                    merge_links(rec, entity_chips("conversation", {label: k}))
                    continue
                n_dropped += 1
                rec = dropped.setdefault(k, {
                    "resref": k, "forks": [],
                    "entries": v["entries"], "replies": v["replies"],
                    "starts": v["starts"], "scripts": v["scripts"],
                    "owners_in_fork": f_owners,
                    "owner_summary": _owner_summary(f_owners),
                    "transcript": v["nodes"],
                    "wiki_links": entity_chips("conversation", {label: k}),
                })
                rec["forks"].append(label)
                merge_links(rec, entity_chips("conversation", {label: k}))
                continue

            b = base_dlgs[k]
            if v["text_hash"] != b["text_hash"] or v["scripts"] != b["scripts"]:
                n_changed += 1
                rec = changed.setdefault(k, {
                    "resref": k, "forks": [],
                    "fork_nodes": v["entries"] + v["replies"],
                    "baseline_nodes": b["entries"] + b["replies"],
                    "scripts_removed": sorted(set(v["scripts"]) - set(b["scripts"])),
                    "scripts_added": sorted(set(b["scripts"]) - set(v["scripts"])),
                    "owners_in_fork": f_owners,
                    "owners_in_baseline": base_owners.get(k, []),
                    "wiki_links": entity_chips(
                        "conversation", {base.wiki_label: k, label: k}),
                })
                rec["forks"].append(label)
                if "diff" not in rec:
                    d = list(difflib.unified_diff(
                        v["transcript"], b["transcript"],
                        fromfile=f"{label}/{k}.dlg", tofile=f"baseline/{k}.dlg",
                        lineterm="", n=1))
                    rec["diff"] = d[:max_diff_lines] if max_diff_lines else d
                    rec["diff_truncated"] = bool(max_diff_lines) and len(d) > max_diff_lines

            # the conversation survived, but is anyone still speaking it?
            f_names = {o["name"] for o in f_owners}
            b_names = {o["name"] for o in base_owners.get(k, [])}
            if f_names and f_names != b_names:
                rec = owner_changed.setdefault(k, {
                    "resref": k, "forks": [],
                    "owners_in_fork": sorted(f_names),
                    "owners_in_baseline": sorted(b_names),
                    "orphaned_now": not b_names,
                    "wiki_links": entity_chips(
                        "conversation", {base.wiki_label: k, label: k}),
                })
                rec["forks"].append(label)

        summary[label] = {"total": len(fd), "dropped": n_dropped,
                          "renamed": n_renamed, "changed": n_changed,
                          "added_in_baseline": len(set(base_dlgs) - set(fd))}

    by_res = lambda r: r["resref"]  # noqa: E731
    return {
        "summary": summary,
        "baseline_total": len(base_dlgs),
        "renamed": sorted(renamed.values(), key=by_res),
        "dropped": sorted(dropped.values(),
                          key=lambda r: (-(r["entries"] + r["replies"]), r["resref"])),
        "changed": sorted(changed.values(),
                          key=lambda r: (-len(r.get("diff") or []), r["resref"])),
        "owner_changed": sorted(owner_changed.values(),
                                key=lambda r: (not r["orphaned_now"], r["resref"])),
    }


# ---------------------------------------------------------------------------
# Shared rendering helpers
# ---------------------------------------------------------------------------

def _fmt_gp(v: Any) -> str:
    n = v or 0
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1000:
        return f"{n / 1000:.1f}k"
    return str(n)


def _val(v: Any) -> str:
    """Render a field value from a rebalance delta."""
    if v is None or v == "":
        return "—"
    if isinstance(v, (list, tuple)):
        return ", ".join(_val(x) for x in v) or "—"
    if isinstance(v, float):
        return f"{v:g}"
    return str(v)


def _primary_url(rec: dict) -> str:
    """The baseline chip's URL if it has one, else the first present chip."""
    for l in rec.get("wiki_links") or []:
        if l["label"] == "live" and l["present"]:
            return l["url"]
    for l in rec.get("wiki_links") or []:
        if l["present"]:
            return l["url"]
    return ""


def _match_kinds(rec: dict) -> str:
    return "/".join(sorted(set(rec.get("match_kinds") or []))) or "—"


def _forks(rec: dict) -> str:
    return ", ".join(rec.get("forks") or []) or "—"


# ---------------------------------------------------------------------------
# Markdown report — the machine-readable companion to the HTML page.  Keeps
# --top truncation; the HTML deliberately does not.
# ---------------------------------------------------------------------------

def _link(name: str, url: str) -> str:
    return f"[{name}]({url})" if url else name


def _wikis(rec: dict) -> str:
    """Per-module wiki links, e.g. '2008 · 2009 · ~~live~~' (~~x~~ = no page)."""
    links = rec.get("wiki_links") or []
    if not links:
        return "—"
    return " · ".join(f"[{l['label']}]({l['url']})" if l["present"]
                      else f"~~{l['label']}~~" for l in links)


def render_markdown(payload: dict, top: int) -> str:
    L: list[str] = []
    w = L.append
    m = payload["modules"]
    b = m["baseline"]
    w(f"# Fork diff — {b['title']}")
    w("")
    w(f"_Generated {payload['generated_at']}. Ancestor forks compared against the "
      f"current module. Identity is resolved resref → tag → name → fuzzy, because "
      f"resrefs are not stable across these forks._")
    w("")
    w(f"_The full, untruncated report is the HTML page; this file is the "
      f"companion summary (top {top} rows per table)._")
    w("")

    w("## Modules")
    w("")
    w("| Role | Module | Wiki | Areas | Creatures | Items |")
    w("| --- | --- | --- | ---: | ---: | ---: |")
    for f in m["forks"]:
        w(f"| fork `{f['wiki_label']}` | {f['title']} | {f['wiki_base']} | {f['areas']} "
          f"| {f['creatures']} | {f['items']} |")
    w(f"| **baseline** | **{b['title']}** | {b['wiki_base']} | {b['areas']} "
      f"| {b['creatures']} | {b['items']} |")
    w("")

    w("## Identity resolution")
    w("")
    w("| Fork | Entity | resref | tag | name | fuzzy | none |")
    w("| --- | --- | ---: | ---: | ---: | ---: | ---: |")
    for label, kinds in payload["match_kinds"].items():
        for plural, counts in kinds.items():
            w(f"| {label} | {plural} | {counts.get('resref', 0)} | {counts.get('tag', 0)} "
              f"| {counts.get('name', 0)} | {counts.get('fuzzy', 0)} | {counts.get('none', 0)} |")
    w("")

    def _rows(title: str, rows: list[dict], cols: list[str],
              cell) -> None:
        w(f"### {title} ({len(rows)})")
        w("")
        if not rows:
            w("_None._")
            w("")
            return
        w("| " + " | ".join(cols) + " |")
        w("| " + " | ".join("---" for _ in cols) + " |")
        for r in rows[:top]:
            w("| " + " | ".join(cell(r)) + " |")
        if len(rows) > top:
            w("")
            w(f"_… {len(rows) - top} more; see the HTML report for the full list._")
        w("")

    lost = payload["lost_content"]
    w("## Lost content to reclaim")
    w("")
    nf = lost.get("noise_filtered") or {}
    if nf:
        w("Filtered as stock blueprints or toolset scaffolding (re-run with "
          "`--include-stock` to see them): "
          + ", ".join(f"{v} {k.replace('_', ' ')}" for k, v in sorted(nf.items())) + ".")
        w("")
    _rows("Areas", lost["areas"], ["Area", "resref", "Wiki", "Creatures", "Stores"],
          lambda a: [_link(a["name"], _primary_url(a)), f"`{a['resref']}`", _wikis(a),
                     str(a["creature_count"]), str(a["store_count"])])
    _rows("Creatures", lost["creatures"], ["Creature", "resref", "Wiki", "CR", "Race"],
          lambda c: [_link(c["name"], _primary_url(c)), f"`{c['resref']}`", _wikis(c),
                     f"{c['cr']:g}", c["race"]])
    _rows("Items", lost["items"], ["Item", "resref", "Wiki", "Base", "Cost"],
          lambda i: [_link(i["name"], _primary_url(i)), f"`{i['resref']}`", _wikis(i),
                     i["base_item"], _fmt_gp(i["cost_gp"])])

    acc = payload["accessibility"]
    w("## Accessibility regressions")
    w("")
    _rows("Items reachable in a fork, unreachable now", acc["items_regressed"],
          ["Item", "resref", "Wiki", "match", "Cost", "Why unreachable now"],
          lambda i: [_link(i["name"], _primary_url(i)), f"`{i['resref']}`", _wikis(i),
                     _match_kinds(i), _fmt_gp(i["cost_gp"]), i["reason_now"] or "—"])
    _rows("Areas that lost their inbound transitions", acc["areas_orphaned"],
          ["Area", "resref", "Wiki", "match", "Creatures", "Inbound in fork"],
          lambda a: [_link(a["name"], _primary_url(a)), f"`{a['resref']}`", _wikis(a),
                     _match_kinds(a), str(a["creature_count"]), str(a["inbound_in_fork"])])
    _rows("Creatures placed in a fork, blueprint-only now",
          acc["creatures_no_longer_spawned"],
          ["Creature", "resref", "Wiki", "match", "CR", "Was in"],
          lambda c: [_link(c["name"], _primary_url(c)), f"`{c['resref']}`", _wikis(c),
                     _match_kinds(c), f"{c['cr']:g}", ", ".join(c["areas_in_fork"]) or "—"])
    _rows("Same content lives under another blueprint (not a regression)",
          acc["creatures_spawned_elsewhere"] + acc["items_regressed_dup"],
          ["Name", "matched resref", "Placed/reachable under"],
          lambda r: [r["name"], f"`{r['resref']}`",
                     ", ".join(f"`{s['resref']}`" for s in r["siblings"] if s["ok"]) or "—"])

    div = payload["divergence"]
    w("## Diverged shared content")
    w("")
    for kind in ("area", "creature", "item"):
        nd = div["by_name"][kind]
        w(f"### {kind.title()}s by name")
        w("")
        for key, title in (("renamed", "Renamed / re-resref'd"),
                           ("only_in_fork", "Only in a fork"),
                           ("only_in_baseline", "Only in the baseline")):
            w(f"- **{title}:** {len(nd[key])}")
        w("")
    _rows("Repurposed resrefs", div["repurposed"],
          ["Kind", "resref", "Was", "Is now", "Wiki"],
          lambda r: [r["kind"], f"`{r['resref']}`", r["fork_name"],
                     _link(r["baseline_name"], _primary_url(r)), _wikis(r)])
    for kind, rows in sorted(div["rebalanced_by_kind"].items()):
        _rows(f"Rebalanced — {kind}s", rows,
              ["Name", "resref", "Wiki", "match", "Changed fields"],
              lambda r: [_link(r["name"], _primary_url(r)), f"`{r['resref']}`",
                         _wikis(r), r["match_kind"], ", ".join(r["changes"])])

    dlg = payload["dialogs"]
    w("## Dialog divergence")
    w("")
    w("| Fork | Conversations | Dropped | Renamed | Changed | Added since |")
    w("| --- | ---: | ---: | ---: | ---: | ---: |")
    for label, s in dlg["summary"].items():
        w(f"| {label} | {s['total']} | {s['dropped']} | {s['renamed']} | {s['changed']} "
          f"| {s['added_in_baseline']} |")
    w("")
    _rows("Dropped conversations", dlg["dropped"],
          ["resref", "Spoken by", "Nodes", "Wiki"],
          lambda r: [f"`{r['resref']}`", r["owner_summary"] or "_no NPC references it_",
                     str(r["entries"] + r["replies"]), _wikis(r)])
    _rows("Changed conversations", dlg["changed"],
          ["resref", "Fork nodes", "Baseline nodes", "Diff lines", "Wiki"],
          lambda r: [f"`{r['resref']}`", str(r["fork_nodes"]), str(r["baseline_nodes"]),
                     str(len(r.get("diff") or [])), _wikis(r)])
    _rows("Renamed conversations", dlg["renamed"],
          ["Fork resref", "Baseline resref", "Nodes", "Wiki"],
          lambda r: [f"`{r['resref']}`", f"`{r['baseline_resref']}`",
                     str(r["nodes"]), _wikis(r)])
    _rows("Conversations whose speaker changed", dlg["owner_changed"],
          ["resref", "Spoken by in fork", "Spoken by now"],
          lambda r: [f"`{r['resref']}`", ", ".join(r["owners_in_fork"]) or "—",
                     ", ".join(r["owners_in_baseline"]) or "_nobody_"])

    sc = payload.get("scripts")
    w("## Script divergence")
    w("")
    if not sc:
        w("_Skipped (`--no-scripts`)._")
        w("")
    else:
        w("| Fork | Dropped | Modified | Identical | Added since |")
        w("| --- | ---: | ---: | ---: | ---: |")
        for label, s in sc["summary"].items():
            w(f"| {label} | {s['dropped']} | {s['modified']} | {s['identical']} "
              f"| {s['added_in_baseline']} |")
        w("")
        needed = [r for r in sc["scripts_dropped"] if r["needed_by"]]
        _rows("Dropped scripts required by lost content", needed,
              ["Script", "Forks", "Lines", "Referenced by"],
              lambda r: [f"`{r['resref']}.nss`", ", ".join(r["forks"]), str(r["lines"]),
                         ", ".join(sorted(set(r["needed_by"]))[:4])])
        others = [r for r in sc["scripts_dropped"] if not r["needed_by"]]
        w(f"### Other dropped scripts ({len(others)})")
        w("")
        w(", ".join(f"`{r['resref']}`" for r in others) or "_None._")
        w("")
        w(f"### Modified scripts ({len(sc['scripts_modified'])})")
        w("")
        w(", ".join(f"`{r['resref']}`" for r in sc["scripts_modified"]) or "_None._")
        w("")

    return "\n".join(L) + "\n"


# ---------------------------------------------------------------------------
# HTML report — the published page.  Complete: no row is truncated away, and
# every href has been existence-checked against that module's built docs/ tree.
# ---------------------------------------------------------------------------

def esc(s: Any) -> str:
    return (str(s if s is not None else "")
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def href(url: str, text: str) -> str:
    """Emit a link, refusing any URL that was not existence-checked."""
    if url not in VERIFIED_URLS:
        raise SystemExit(f"[fork-diff] refusing to emit unverified link: {url}")
    return f'<a href="{esc(url)}">{esc(text)}</a>'


def linked(rec: dict, text: str) -> str:
    url = _primary_url(rec)
    return href(url, text) if url else esc(text)


def chips(rec: dict) -> str:
    """Per-module presence chips: a link where the entity has a page, a muted
    chip where it does not.  The muted chip is the point — it says *this module
    does not have this entity*, which a missing link cannot say."""
    links = rec.get("wiki_links") or []
    if not links:
        return '<span class="fd-chip fd-chip-off">—</span>'
    out = []
    for l in sorted(links, key=lambda l: l["label"]):
        if l["present"]:
            out.append(f'<a class="fd-chip" href="{esc(l["url"])}" '
                       f'title="{esc(l["resref"])}">{esc(l["label"])}</a>')
        else:
            out.append(f'<span class="fd-chip fd-chip-off" '
                       f'title="not in this module">{esc(l["label"])}</span>')
    return "".join(out)


def code(s: Any) -> str:
    return f"<code>{esc(s)}</code>" if s else "—"


class Page:
    """Accumulates HTML plus the table of contents it needs."""

    OPEN_LIMIT = 50  # rows below which a block starts expanded

    def __init__(self) -> None:
        self.parts: list[str] = []
        self.toc: list[tuple[int, str, str]] = []
        self._n = 0

    def w(self, s: str) -> None:
        self.parts.append(s)

    def h2(self, title: str, sub: str = "") -> str:
        anchor = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
        self.toc.append((2, anchor, title))
        self.w(f'<div class="tier-header" id="{anchor}"><h2>{esc(title)}</h2>'
               + (f'<p class="tier-sub">{sub}</p>' if sub else "") + "</div>")
        return anchor

    def h3(self, title: str, sub: str = "") -> str:
        anchor = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
        self.toc.append((3, anchor, title))
        self.w(f'<h3 id="{anchor}">{esc(title)}</h3>')
        if sub:
            self.w(f'<p class="muted">{sub}</p>')
        return anchor

    def note(self, html: str, cls: str = "tip-box") -> None:
        self.w(f'<div class="{cls}"><p>{html}</p></div>')

    def block(self, title: str, count: int, body: str, *, sub: str = "",
              open_: bool | None = None) -> None:
        """A collapsible subsection carrying its own row count."""
        if open_ is None:
            open_ = 0 < count <= self.OPEN_LIMIT
        if not count:
            self.w(f'<details class="fd-block"><summary>{esc(title)} '
                   f'<span class="fd-count">0</span></summary>'
                   f'<p class="muted">None.</p></details>')
            return
        self.w(f'<details class="fd-block"{" open" if open_ else ""}>'
               f'<summary>{esc(title)} <span class="fd-count">{count}</span></summary>'
               + (f'<p class="muted">{sub}</p>' if sub else "") + body + "</details>")

    def table(self, headers: list[str], rows: list[list[str]], *,
              nums: set[int] = frozenset(), filterable: bool = True) -> str:
        """A scrollable table, optionally with a live text filter above it."""
        if not rows:
            return '<p class="muted">None.</p>'
        self._n += 1
        tid = f"fdt{self._n}"
        head = "".join(f'<th{" class=num" if i in nums else ""}>{esc(h)}</th>'
                       for i, h in enumerate(headers))
        body = []
        for r in rows:
            cells = "".join(f'<td{" class=num" if i in nums else ""}>{c}</td>'
                            for i, c in enumerate(r))
            body.append(f"<tr>{cells}</tr>")
        filt = (f'<input class="fd-filter" type="search" data-target="{tid}" '
                f'placeholder="Filter {len(rows)} rows…" aria-label="Filter table">'
                if filterable and len(rows) > 12 else "")
        return (f'{filt}<div class="fd-scroll"><table id="{tid}"><thead><tr>{head}'
                f'</tr></thead><tbody>{"".join(body)}</tbody></table></div>')

    def render_toc(self) -> str:
        out = ['<nav class="toc" aria-label="Page contents"><h2>Contents</h2><ol>']
        for level, anchor, title in self.toc:
            cls = ' class="toc-sub"' if level > 2 else ""
            out.append(f'<li{cls}><a href="#{anchor}">{esc(title)}</a></li>')
        out.append("</ol></nav>")
        return "".join(out)


