    .fd-chip-off { color: var(--muted); border-style: dashed; opacity: 0.6;
                   text-decoration: line-through; }
    .fd-diff { background: rgba(30,30,60,0.05); border: 1px solid var(--border);
               border-radius: 3px; padding: 0.5em 0.7em; overflow-x: auto;
               font-size: 0.82em; line-height: 1.35; max-height: 26em; }
    .fd-diff .del { color: #a03030; }
    .fd-diff .add { color: #2e7030; }
    .fd-diff .hunk { color: var(--muted); }
    .fd-lines { margin: 0.2em 0 0.4em 1.1em; padding: 0; font-size: 0.9em; }
    .fd-lines li { margin: 0.05em 0; }
    .fd-sub { margin: 1.4em 0 0.4em; font-size: 1.02em; color: var(--accent); }
    .fd-transcript { font-size: 0.86em; margin: 0.3em 0 0.8em; }
    .fd-transcript dt { color: var(--muted); font-size: 0.9em; margin-top: 0.4em; }
    .fd-transcript dd { margin: 0 0 0 1em; }
"""

FD_SCRIPT = """
document.querySelectorAll('.fd-filter').forEach(function (box) {
  box.addEventListener('input', function () {
    var q = box.value.toLowerCase();
    var rows = document.getElementById(box.dataset.target)
                       .tBodies[0].rows;
    for (var i = 0; i < rows.length; i++) {
      rows[i].style.display =
        (!q || rows[i].textContent.toLowerCase().indexOf(q) !== -1) ? '' : 'none';
    }
  });
});
"""


def _changes_html(changes: dict) -> str:
    """Full change list for one rebalanced entity — no field or length cap."""
    out = []
    for f, v in sorted(changes.items()):
        if isinstance(v, dict) and "fork" in v:
            out.append(f"<li><b>{esc(f)}</b>: {esc(_val(v['fork']))} → "
                       f"{esc(_val(v['baseline']))}</li>")
        elif isinstance(v, dict):
            bits = []
            for lbl, key in (("removed since", "removed"), ("added since", "added")):
                vals = v.get(key) or []
                if vals:
                    bits.append(f'<li>{lbl}: ' + ", ".join(
                        f"<code>{esc(x)}</code>" for x in vals) + "</li>")
            out.append(f"<li><b>{esc(f)}</b><ul class=\"fd-lines\">"
                       + "".join(bits) + "</ul></li>")
    return f'<ul class="fd-lines">{"".join(out)}</ul>'


def _diff_html(diff: list[str], truncated: bool) -> str:
    if not diff:
        return ""
    rows = []
    for line in diff:
        cls = ("hunk" if line.startswith("@@") else
               "del" if line.startswith("-") else
               "add" if line.startswith("+") else "")
        rows.append(f'<span class="{cls}">{esc(line)}</span>' if cls else esc(line))
    tail = ('\n<span class="hunk">… diff truncated (--max-diff-lines)</span>'
            if truncated else "")
    return f'<pre class="fd-diff">{chr(10).join(rows)}{tail}</pre>'


def _transcript_html(nodes: list[dict]) -> str:
    out = ['<dl class="fd-transcript">']
    for n in nodes:
        meta = []
        if n.get("script"):
            meta.append(f'action <code>{esc(n["script"])}</code>')
        if n.get("active"):
            meta.append(f'shown if <code>{esc(n["active"])}</code>')
        tag = f'{n["role"]} {n["index"]}'
        out.append(f"<dt>{esc(tag)}"
                   + (f' <span class="muted">({", ".join(meta)})</span>' if meta else "")
                   + "</dt>")
        out.append(f"<dd>{esc(n['text']) or '<i>(no text)</i>'}</dd>")
    out.append("</dl>")
    return "".join(out)


def render_html(payload: dict) -> str:
    p = Page()
    m = payload["modules"]
    b = m["baseline"]
    mods = m["forks"] + [b]

    p.w(f"<h1>Fork diff — {esc(b['title'])}</h1>")
    p.w(f'<p class="muted">Generated {esc(payload["generated_at"])} by '
        f"<code>nwn-fork-diff</code>. Regenerate rather than edit — this page is "
        f"overwritten wholesale on the next run.</p>")
    p.w("<p>The two ancestor forks of this module, compared against what is live now: "
        "what they have that we lost, what we still have but orphaned, and how the "
        "content we share drifted apart. Identity is resolved "
        "<b>resref → tag → name → fuzzy</b>, because resrefs are not stable across "
        "these forks.</p>")

    p.w(p.table(
        ["Role", "Module", "Wiki", "Areas", "Creatures", "Items"],
        [[("fork" if mod is not b else "<b>baseline</b>"),
          esc(mod["title"]),
          f'<code>{esc(mod["wiki_label"])}</code> — {esc(mod["wiki_base"])}',
          str(mod["areas"]), str(mod["creatures"]), str(mod["items"])]
         for mod in mods],
        nums={3, 4, 5}, filterable=False))

    p.note(
        "<b>Reading the wiki chips.</b> Every row carries one chip per module: "
        + " ".join(f'<code>{esc(mod["wiki_label"])}</code>' for mod in mods)
        + ". A <b>solid chip is a link</b> to that entity's page in that module's "
        "wiki; a <b>struck-through chip means the entity does not exist there</b> — "
        "which is usually the finding. Chips are resolved per module by that module's "
        "own resref (hover a chip to see it), because renamed content carries a "
        "different resref in each. Every link on this page was checked against the "
        "built wiki before being emitted, so none of them 404.")

    # -- identity resolution --------------------------------------------
    p.h2("Identity resolution",
         "Which rule matched each fork entity to a baseline one.")
    p.w(p.table(
        ["Fork", "Entity", "resref", "tag", "name", "fuzzy", "none"],
        [[esc(label), plural, str(c.get("resref", 0)), str(c.get("tag", 0)),
          str(c.get("name", 0)), str(c.get("fuzzy", 0)), str(c.get("none", 0))]
         for label, kinds in payload["match_kinds"].items()
         for plural, c in kinds.items()],
        nums={2, 3, 4, 5, 6}, filterable=False))
    p.note("<code>tag</code> / <code>name</code> / <code>fuzzy</code> matches are "
           "content that survived under a <b>different resref</b> — renamed or "
           "rebuilt, not lost. Only <code>none</code> is a migration candidate.")

    # -- lost content ----------------------------------------------------
    lost = payload["lost_content"]
    p.h2("Lost content to reclaim",
         "Fork content that resolved to nothing in the baseline, ranked by how much "
         "comes back with it.")
    nf = lost.get("noise_filtered") or {}
    if nf:
        p.note("Filtered as stock blueprints or toolset scaffolding (re-run with "
               "<code>--include-stock</code> to see them): "
               + ", ".join(f"{v} {k.replace('_', ' ')}"
                           for k, v in sorted(nf.items())) + ".")

    rows = []
    for a in lost["areas"]:
        contained = a.get("contains", {}).get("creatures") or []
        manifest = ", ".join(
            f'{linked(c, c["name"])} <span class="muted">(CR {c["cr"]:g}'
            + (f' ×{c["count"]}' if c["count"] > 1 else "") + ")</span>"
            for c in contained) or '<span class="muted">—</span>'
        rows.append([linked(a, a["name"]), code(a["resref"]), chips(a),
                     esc(_forks(a)), str(a["creature_count"]),
                     str(a["encounter_count"]), str(a["store_count"]),
                     f'{a["inbound"]}→/→{a["outbound"]}', manifest])
    p.block("Areas", len(lost["areas"]), p.table(
        ["Area", "resref", "Wiki", "In fork(s)", "Creatures", "Encounters",
         "Stores", "Links", "Carries"], rows, nums={4, 5, 6}),
        sub="Every creature each lost area carried is listed, so reclaiming an area "
            "shows what comes with it.")

    p.block("Creatures", len(lost["creatures"]), p.table(
        ["Creature", "resref", "Wiki", "In fork(s)", "CR", "HP", "Race", "Faction",
         "Placed in"],
        [[linked(c, c["name"]), code(c["resref"]), chips(c), esc(_forks(c)),
          f'{c["cr"]:g}', esc(c["hp"]), esc(c["race"]), esc(c["faction"]),
          esc(", ".join(a for a in c["areas"] if a)) or "<i>blueprint only</i>"]
         for c in lost["creatures"]], nums={4, 5}))

    p.block("Items", len(lost["items"]), p.table(
        ["Item", "resref", "Wiki", "In fork(s)", "Base item", "Cost",
         "Reachable in fork", "Obtained from"],
        [[linked(i, i["name"]), code(i["resref"]), chips(i), esc(_forks(i)),
          esc(i["base_item"]), _fmt_gp(i["cost_gp"]),
          "yes" if i["accessible_in_fork"] else "no",
          esc("; ".join(i.get("sources") or [])) or "—"]
         for i in lost["items"]], nums={5}))

    # -- accessibility ---------------------------------------------------
    acc = payload["accessibility"]
    p.h2("Accessibility regressions",
         "Content the baseline still has, but players can no longer reach.")

    reg = acc["items_regressed"]
    per = ", ".join(f"{k}: {v}" for k, v in sorted(acc["items_regressed_by_fork"].items()))
    p.block("Items reachable in a fork, unreachable now", len(reg), p.table(
        ["Item", "resref", "Wiki", "In fork(s)", "match", "Cost",
         "Why unreachable now", "Was obtained from"],
        [[linked(i, i["name"]), code(i["resref"]), chips(i), esc(_forks(i)),
          esc(_match_kinds(i)), _fmt_gp(i["cost_gp"]),
          esc(i["reason_now"]) or "—",
          esc("; ".join(i["sources_in_fork"])) or "—"]
         for i in reg], nums={5}),
        sub=f"Per fork: {esc(per)}. Counter-check: {acc['items_improved_count']} "
            f"item(s) moved the other way (unreachable in a fork, reachable now).")

    orph = acc["areas_orphaned"]
    p.block("Areas that lost their inbound transitions", len(orph), p.table(
        ["Area", "resref", "Wiki", "In fork(s)", "match", "Creatures",
         "Inbound in fork", "Hidden"],
        [[linked(a, a["name"]), code(a["resref"]), chips(a), esc(_forks(a)),
          esc(_match_kinds(a)), str(a["creature_count"]), str(a["inbound_in_fork"]),
          "yes" if a.get("hidden") else ""]
         for a in orph], nums={5, 6}),
        sub="Counts door, trigger and conversation transitions only — an area still "
            "reached by a script teleport will show up here anyway.")

    spawn = acc["creatures_no_longer_spawned"]
    p.block("Creatures placed in a fork, blueprint-only now", len(spawn), p.table(
        ["Creature", "resref", "Wiki", "In fork(s)", "match", "CR",
         "Was placed in", "Baseline blueprints of this name"],
        [[linked(c, c["name"]), code(c["resref"]), chips(c), esc(_forks(c)),
          esc(_match_kinds(c)), f'{c["cr"]:g}',
          esc(", ".join(c["areas_in_fork"])) or "—",
          ", ".join(f'<code>{esc(s["resref"])}</code>' for s in c["siblings"]) or "—"]
         for c in spawn], nums={5}),
        sub="No blueprint of this name is placed anywhere in the baseline, so the "
            "creature really is absent from the live world. The last column lists "
            "every baseline blueprint sharing the name — pick one to place.")

    dup = (acc["creatures_spawned_elsewhere"] + acc["items_regressed_dup"]
           + acc["areas_orphaned_dup"])
    p.block("Same content is live under a different blueprint (not a regression)",
            len(dup), p.table(
        ["Kind", "Name", "Matched blueprint", "Live under", "Wiki"],
        [[r["kind"], linked(r, r["name"]), code(r["resref"]),
          ", ".join(f'<code>{esc(s["resref"])}</code>'
                    for s in r["siblings"] if s["ok"]) or "—",
          chips(r)] for r in dup]),
        sub="These matched an unplaced/unreachable baseline blueprint, but another "
            "blueprint of the <b>same name</b> is placed or reachable — identity "
            "resolution consumes each baseline entity once, so it can land on the "
            "dead twin of a name that is perfectly alive. Listed so you can see why "
            "an entry you expected above is not there.", open_=False)

    # -- content by name -------------------------------------------------
    div = payload["divergence"]
    p.h2("Content by name",
         "The same comparison keyed on names instead of resrefs.")
    p.note("resrefs are the wrong axis for &ldquo;what changed&rdquo;. "
           "<code>areaNNN</code> comes from the toolset's New Area Wizard and "
           "<code>&lt;stem&gt;NNN</code> from palette copy-paste, so two modules can "
           "hold the same content under different resrefs and different content under "
           "the same one. Keyed on name, the resref pair becomes supporting detail "
           "(&ldquo;was <i>X</i>, is now <i>Y</i>&rdquo;) instead of the thing being "
           "matched on.")
    for kind in ("area", "creature", "item"):
        nd = div["by_name"][kind]
        p.h3(f"{kind.title()}s by name")
        p.block(f"Renamed / re-resref'd {kind}s", len(nd["renamed"]), p.table(
            ["Name", "In fork", "Fork resref", "Baseline resref(s)", "Wiki",
             "Autonumbered"],
            [[linked(r, r["name"]), esc(r["fork"]), code(r["fork_resref"]),
              ", ".join(f'<code>{esc(x)}</code>' for x in r["baseline_resrefs"]),
              chips(r), "yes" if r["autonumbered"] else ""]
             for r in nd["renamed"]]),
            sub="Same name on both sides, different resref — the content survived, "
                "the slot moved.")
        p.block(f"{kind.title()}s only a fork has (by name)", len(nd["only_in_fork"]),
                p.table(["Name", "In fork(s)", "Fork resref(s)", "Wiki"],
                        [[linked(r, r["name"]), esc(_forks(r)),
                          ", ".join(f'<code>{esc(v)}</code>'
                                    for v in r["fork_resrefs"].values()),
                          chips(r)] for r in nd["only_in_fork"]]))
        p.block(f"{kind.title()}s only the baseline has (by name)",
                len(nd["only_in_baseline"]),
                p.table(["Name", "Baseline resref(s)", "Wiki"],
                        [[linked(r, r["name"]),
                          ", ".join(f'<code>{esc(x)}</code>'
                                    for x in r["baseline_resrefs"]),
                          chips(r)] for r in nd["only_in_baseline"]]),
                sub="Added since the fork.")

    # -- diverged shared content -----------------------------------------
    p.h2("Diverged shared content",
         "Entities both sides have, holding different content or different numbers.")

    rep = div["repurposed"]
    p.block("Repurposed resrefs", len(rep), p.table(
        ["Kind", "resref", "Was (in fork)", "Is now (baseline)", "In fork(s)", "Wiki"],
        [[r["kind"], code(r["resref"]), esc(r["fork_name"]),
          linked(r, r["baseline_name"]), esc(_forks(r)), chips(r)]
         for r in rep]),
        sub="Same resref, entirely different content — the blueprint slot was reused. "
            "Worth auditing against <code>item_tag_conflicts.json</code> / "
            "<code>creature_tag_conflicts.json</code>.")

    auto = div["repurposed_autonumbered"]
    p.block("Autonumbered resref collisions (not evidence of anything)", len(auto),
            p.table(["Kind", "resref", "Was (in fork)", "Is now (baseline)", "Wiki"],
                    [[r["kind"], code(r["resref"]), esc(r["fork_name"]),
                      linked(r, r["baseline_name"]), chips(r)] for r in auto]),
            sub="The toolset assigns these resrefs, so two modules landing on the same "
                "one means nothing was deliberately repurposed. Separated out so they "
                "do not drown the list above.", open_=False)

    p.h3("Rebalanced")
    p.w('<p class="muted">Matched on both sides, same content, different numbers. '
        'Split by entity type; every changed field is listed in full.</p>')
    for kind in ("creature", "item", "area"):
        rows = div["rebalanced_by_kind"].get(kind, [])
        p.block(f"Rebalanced {kind}s", len(rows), p.table(
            ["Name", "resref", "Wiki", "In fork", "match", "Changes"],
            [[linked(r, r["name"])
              + (f'<br><span class="muted">was {esc(r["fork_name"])}</span>'
                 if r.get("fork_name") else ""),
              code(r["resref"]), chips(r), esc(r["fork"]), esc(r["match_kind"]),
              _changes_html(r["changes"])]
             for r in rows]), open_=False)

    # -- dialogs ---------------------------------------------------------
    dlg = payload["dialogs"]
    p.h2("Dialog divergence",
         "The module's writing: who said what, what stopped being said, and what "
         "got rewritten.")
    p.w(p.table(
        ["Fork", "Conversations", "Dropped", "Renamed", "Changed", "Added since"],
        [[esc(label), str(s["total"]), str(s["dropped"]), str(s["renamed"]),
          str(s["changed"]), str(s["added_in_baseline"])]
         for label, s in dlg["summary"].items()]
        + [["<b>baseline</b>", str(dlg["baseline_total"]), "", "", "", ""]],
        nums={1, 2, 3, 4, 5}, filterable=False))
    p.note("Conversations are compared on their <b>text</b>, not their node counts: a "
           "conversation rewritten line-by-line without changing shape used to be "
           "invisible, and one that merely moved to a new resref used to look dropped. "
           "Renames are resolved first, so the dropped list below is real loss.")

    ren = dlg["renamed"]
    p.block("Renamed conversations", len(ren), p.table(
        ["Fork resref", "Baseline resref", "In fork(s)", "Nodes", "Spoken by in fork",
         "Wiki"],
        [[code(r["resref"]), code(r["baseline_resref"]), esc(_forks(r)),
          str(r["nodes"]),
          esc(_owner_summary(r["owners_in_fork"])) or "—", chips(r)]
         for r in ren], nums={3}),
        sub="Identical text under a different resref — not lost, just moved.")

    drop = dlg["dropped"]
    body = []
    for r in drop:
        owners = esc(r["owner_summary"]) or "<i>no NPC in the fork referenced it</i>"
        scripts = (", ".join(f"<code>{esc(s)}</code>" for s in r["scripts"])
                   or '<span class="muted">none</span>')
        body.append(
            f'<details class="fd-block"><summary><code>{esc(r["resref"])}</code> '
            f'<span class="fd-count">{r["entries"] + r["replies"]} nodes</span> '
            f'<span class="muted">— {owners}</span></summary>'
            f'<p class="muted">In {esc(_forks(r))}. '
            f'{r["entries"]} NPC / {r["replies"]} PC nodes, {r["starts"]} entry '
            f'point(s). Scripts: {scripts}. {chips(r)}</p>'
            + _transcript_html(r["transcript"]) + "</details>")
    p.block("Dropped conversations", len(drop), "".join(body),
            sub="Gone from the baseline entirely. Each expands to its full transcript "
                "— including the scripts each node fired — so the writing can be "
                "reclaimed straight off this page.", open_=False)

    chg = dlg["changed"]
    body = []
    for r in chg:
        bits = []
        if r["scripts_removed"]:
            bits.append("scripts dropped: " + ", ".join(
                f"<code>{esc(s)}</code>" for s in r["scripts_removed"]))
        if r["scripts_added"]:
            bits.append("scripts added: " + ", ".join(
                f"<code>{esc(s)}</code>" for s in r["scripts_added"]))
        meta = (f'<p class="muted">In {esc(_forks(r))}. '
                f'{r["fork_nodes"]} nodes in the fork → {r["baseline_nodes"]} now. '
                + ("; ".join(bits) + ". " if bits else "")
                + f'Spoken by: {esc(_owner_summary(r["owners_in_baseline"])) or "nobody"}'
                  f'. {chips(r)}</p>')
        body.append(
            f'<details class="fd-block"><summary><code>{esc(r["resref"])}</code> '
            f'<span class="fd-count">{len(r.get("diff") or [])} diff lines</span>'
            f'</summary>{meta}'
            + _diff_html(r.get("diff") or [], r.get("diff_truncated", False))
            + "</details>")
    p.block("Rewritten conversations", len(chg), "".join(body),
            sub="Text or attached scripts changed. The diff runs fork → baseline, so "
                "<span class=\"fd-diff\" style=\"padding:0 .3em\">"
                "<span class=\"del\">-</span></span> is a line the fork had and "
                "<span class=\"fd-diff\" style=\"padding:0 .3em\">"
                "<span class=\"add\">+</span></span> is what replaced it.",
            open_=False)

    own = dlg["owner_changed"]
    p.block("Conversations whose speaker changed", len(own), p.table(
        ["resref", "In fork(s)", "Spoken by in the fork", "Spoken by now", "Wiki"],
        [[code(r["resref"]), esc(_forks(r)),
          esc(", ".join(r["owners_in_fork"])) or "—",
          esc(", ".join(r["owners_in_baseline"]))
          or "<b>nobody — orphaned</b>", chips(r)]
         for r in own]),
        sub="The conversation still exists, but a different NPC speaks it — or none "
            "does, which means players can no longer hear it.")

    # -- scripts (deliberately not detailed here) ------------------------
    sc = payload.get("scripts")
    p.h2("Script divergence", "Recorded, not listed — see the JSON.")
    if not sc:
        p.w('<p class="muted">Skipped (<code>--no-scripts</code>).</p>')
    else:
        tot_drop = len(sc["scripts_dropped"])
        tot_mod = len(sc["scripts_modified"])
        needed = sum(1 for r in sc["scripts_dropped"] if r["needed_by"])
        p.w(f"<p>The forks carry <b>{tot_drop}</b> <code>.nss</code> scripts the "
            f"baseline does not ({needed} of them referenced by content in the lost "
            f"list above), and <b>{tot_mod}</b> scripts exist on both sides with "
            f"different source. Script-level detail — including the unified diff of "
            f"every modified script — is deliberately kept out of this page and "
            f"lives in <code>module-index/fork_diff.json</code> and "
            f"<code>fork_diff.md</code>, which are regenerated by the same run.</p>")

    body = "".join(p.parts)
    # Everything outside <body> is dropped by the wiki generator, which builds
    # its own <head> (and re-escapes the <title>, so keep it free of & and ').
    # The <style> therefore has to live *inside* <main>, as ManualPageTemplate
    # does it — in <head> it would silently vanish from the published page.
    return (
        '<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="utf-8">\n'
        '  <meta name="viewport" content="width=device-width, initial-scale=1">\n'
        f'  <title>Fork diff: 2008 and 2009 vs. {esc(b["title"])}</title>\n'
        '  <link rel="stylesheet" href="../../assets/style.css">\n'
        "</head>\n<body>\n  <main>\n"
        f"  <style>{FD_STYLE}  </style>\n"
        '  <div class="mw-layout">\n    <aside class="mw-toc-pane">'
        + p.render_toc()
        + '</aside>\n    <div class="mw-content">\n'
        + body
        + "\n    </div><!-- .mw-content -->\n  </div><!-- .mw-layout -->\n"
        f"  <script>{FD_SCRIPT}  </script>\n  </main>\n</body>\n</html>\n")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def _die(msg: str) -> "int":
    raise SystemExit(f"[fork-diff] {msg}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="nwn-fork-diff",
        description="Compare ancestor module forks against a baseline module.")
    ap.add_argument("--fork", action="append", required=True, metavar="REPO",
                    help="ancestor module repo root (repeatable)")
    ap.add_argument("--baseline", required=True, metavar="REPO",
                    help="current module repo root")
    ap.add_argument("--wiki-url", action="append", required=True, metavar="REPO=URL",
                    help="published wiki base URL for a repo, by path or basename "
                         "(required once per --baseline/--fork; repeatable)")
    ap.add_argument("--out", metavar="DIR",
                    help="output directory for fork_diff.json/.md "
                         "(default: BASELINE/module-index)")
    ap.add_argument("--html", metavar="FILE",
                    help="HTML report path "
                         "(default: BASELINE/docs.manual/Draft/ForkDiff.html)")
    ap.add_argument("--no-scripts", action="store_true",
                    help="skip the .nss/.dlg comparison (the slowest pass)")
    ap.add_argument("--no-fuzzy", action="store_true",
                    help="skip fuzzy name matching in identity resolution")
    ap.add_argument("--include-stock", action="store_true",
                    help="do not filter stock/CEP blueprints and scaffolding")
    ap.add_argument("--top", type=int, default=40, metavar="N",
                    help="rows per table in the Markdown report (default: 40)")
    ap.add_argument("--max-diff-lines", type=int, default=80, metavar="N",
                    help="unified-diff lines kept per modified script (0 = none)")
    args = ap.parse_args(argv)

    # Wiki base URLs are explicit and mandatory.  They used to be read out of
    # each module-index's `wiki_url` fields, which is how the published report
    # ended up full of dead links: a wiki build without --base-url writes local
    # filesystem paths into every one of them, and nothing downstream noticed.
    urls: dict[str, str] = {}
    for spec in args.wiki_url:
        repo, sep, url = spec.partition("=")
        if not sep or not url.strip():
            return _die(f"--wiki-url needs REPO=URL, got {spec!r}")
        urls[repo.strip().rstrip("/")] = url.strip()

    def _wiki_base_for(root: Path) -> str:
        for key in (str(root), root.name):
            if key in urls:
                return urls[key]
        return _die(f"no --wiki-url given for {root} — pass "
                    f"--wiki-url {root.name}=https://…/")

    base = Module(Path(args.baseline).resolve(),
                  _wiki_base_for(Path(args.baseline).resolve()))
    forks: list[tuple[str, Module]] = []
    for f in args.fork:
        root = Path(f).resolve()
        mod = Module(root, _wiki_base_for(root))
        forks.append((root.name, mod))
    base.wiki_label = short_wiki_label(base, True)
    for _, mod in forks:
        mod.wiki_label = short_wiki_label(mod, False)
    # Findings are keyed by wiki label from here on, so every module can be
    # given a presence chip on every row.
    forks = [(mod.wiki_label, mod) for _, mod in forks]
    ALL_MODULES[:] = [(base.wiki_label, base)] + list(forks)
    labels = [l for l, _ in ALL_MODULES]
    if len(set(labels)) != len(labels):
        return _die(f"wiki labels are not unique: {labels} — the hosts in "
                    f"--wiki-url must differ in their first label")

    print(f"[fork-diff] baseline: {base.title} ({base.root})", file=sys.stderr)
    for label, mod in forks:
        print(f"[fork-diff] fork:     {mod.title} ({label})", file=sys.stderr)

    # Component 1
    resolved: dict[str, dict] = {}
    match_kinds: dict[str, dict] = {}
    for label, mod in forks:
        resolved[label] = {
            "areas": resolve_identity(mod.areas, base.areas, fuzzy=not args.no_fuzzy),
            "creatures": resolve_identity(mod.creatures, base.creatures, fuzzy=not args.no_fuzzy),
            "items": resolve_identity(mod.items, base.items, fuzzy=not args.no_fuzzy),
        }
        match_kinds[label] = {}
        for plural, table in resolved[label].items():
            counts: dict[str, int] = {}
            for m in table.values():
                counts[m["match_kind"]] = counts.get(m["match_kind"], 0) + 1
            match_kinds[label][plural] = counts
        print(f"[fork-diff] {label}: matched "
              + ", ".join(f"{p}={match_kinds[label][p]}" for p in ("areas", "creatures", "items")),
              file=sys.stderr)

    lost = lost_content(forks, base, resolved, args.include_stock)
    acc = accessibility(forks, base, resolved)
    div = divergence(forks, base, resolved, args.include_stock)
    scripts = None if args.no_scripts else script_divergence(
        forks, base, lost, args.max_diff_lines)
    dialogs = dialog_divergence(forks, base, args.max_diff_lines)

    def _mod_row(mod: Module) -> dict:
        return {"label": mod.root.name, "title": mod.title,
                "wiki_label": mod.wiki_label, "wiki_base": mod.wiki_base,
                "root": str(mod.root), "areas": len(mod.areas),
                "creatures": len(mod.creatures), "items": len(mod.items)}

    payload = {
        "generated_at": _dt.datetime.now().replace(microsecond=0).isoformat(),
        "modules": {
            "baseline": _mod_row(base),
            "forks": [_mod_row(m) for _, m in forks],
        },
        "match_kinds": match_kinds,
        "lost_content": lost,
        "accessibility": acc,
        "divergence": div,
        "dialogs": dialogs,
    }
    if scripts is not None:
        payload["scripts"] = scripts

    out_dir = Path(args.out).resolve() if args.out else base.index_dir
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "fork_diff.json").write_text(
        json.dumps(payload, indent=1, ensure_ascii=False), encoding="utf-8")
    (out_dir / "fork_diff.md").write_text(
        render_markdown(payload, args.top), encoding="utf-8")

    html_path = (Path(args.html).resolve() if args.html
                 else base.root / "docs.manual" / "Draft" / "ForkDiff.html")
    html = render_html(payload)  # raises on any unverified href
    html_path.parent.mkdir(parents=True, exist_ok=True)
    html_path.write_text(html, encoding="utf-8")

    n_href = html.count(' href="http')
    print(f"[fork-diff] lost: {len(lost['areas'])} area(s), {len(lost['creatures'])} creature(s), "
          f"{len(lost['items'])} item(s)", file=sys.stderr)
    print(f"[fork-diff] accessibility regressions: {len(acc['items_regressed'])} item(s), "
          f"{len(acc['areas_orphaned'])} area(s), "
          f"{len(acc['creatures_no_longer_spawned'])} creature(s) "
          f"({len(acc['creatures_spawned_elsewhere'])} demoted: live under another "
          f"blueprint)", file=sys.stderr)
    print(f"[fork-diff] diverged: {len(div['repurposed'])} repurposed "
          f"(+{len(div['repurposed_autonumbered'])} autonumbered), "
          f"{len(div['rebalanced'])} rebalanced", file=sys.stderr)
    print(f"[fork-diff] dialogs: {len(dialogs['dropped'])} dropped, "
          f"{len(dialogs['renamed'])} renamed, {len(dialogs['changed'])} rewritten, "
          f"{len(dialogs['owner_changed'])} reassigned", file=sys.stderr)
    print(f"[fork-diff] links: {n_href} emitted, {len(VERIFIED_URLS)} distinct URLs, "
          f"all existence-checked against the built docs/ trees", file=sys.stderr)
    print(f"[fork-diff] wrote {out_dir / 'fork_diff.json'}, {out_dir / 'fork_diff.md'} "
          f"and {html_path}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
