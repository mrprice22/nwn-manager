#!/usr/bin/env python3
"""nwn-wiki — generate a static HTML wiki from an unpacked NWN1 module.

Thin CLI shim; the implementation lives in the nwn_wiki package beside this
file.  Run --help for usage.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from nwn_wiki.cli import main  # noqa: E402  (needs the sys.path line above)

if __name__ == "__main__":
    sys.exit(main())
