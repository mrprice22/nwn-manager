#!/usr/bin/env python3
"""shift-log-timestamps — one-time migration tool to shift NWN server log timestamps.

Rewrites every timestamp in all nwserverLog*.txt files found under a log
root directory by the given UTC hour offset. Use this to convert UTC log
timestamps to local time so they match your --log-timezone setting in
nwn-wiki.

Usage:
  shift-log-timestamps <log-root-dir> <offset-hours>

Examples:
  # Convert UTC logs to US Central (GMT-5), searching logs.0/ … logs.N/
  shift-log-timestamps ~/.local/state/nwnxee-homer -5

  # Dry run (show what would change without writing):
  shift-log-timestamps ~/.local/state/nwnxee-homer -5 --dry-run

WARNING: This modifies log files in place. Make a backup first if you
want to be able to undo. Running the script twice will double-shift.
"""

from __future__ import annotations

import re
import sys
from datetime import datetime, timedelta
from pathlib import Path

HEADER_RE = re.compile(
    r'^(Messages for: )(\w{3} \w{3} [ \d]\d \d{2}:\d{2}:\d{2} )(\d{4})(.*)'
)
EVENT_RE = re.compile(
    r'^(\[)(\w{3} \w{3} [ \d]\d \d{2}:\d{2}:\d{2})(\])(.*)'
)


def _fmt_dt(dt: datetime, include_year: bool = False) -> str:
    day_str = f"{dt.day:2d}"
    base = f"{dt.strftime('%a %b')} {day_str} {dt.strftime('%H:%M:%S')}"
    if include_year:
        return base + f" {dt.year}"
    return base


def shift_file(path: Path, offset: timedelta, dry_run: bool) -> int:
    text = path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    new_lines: list[str] = []
    year = datetime.now().year
    changed = 0

    for line in lines:
        m = HEADER_RE.match(line)
        if m:
            prefix, ts_str, yr_str, suffix = m.group(1), m.group(2), m.group(3), m.group(4)
            year = int(yr_str)
            norm = re.sub(r" +", " ", (ts_str + yr_str).strip())
            try:
                dt = datetime.strptime(norm, "%a %b %d %H:%M:%S %Y") + offset
            except ValueError:
                new_lines.append(line)
                continue
            year = dt.year
            new_line = prefix + _fmt_dt(dt, include_year=True) + suffix
            new_lines.append(new_line)
            changed += 1
            continue

        m = EVENT_RE.match(line)
        if m:
            open_br, ts_str, close_br, rest = m.group(1), m.group(2), m.group(3), m.group(4)
            norm = re.sub(r" +", " ", ts_str.strip())
            try:
                dt = datetime.strptime(f"{norm} {year}", "%a %b %d %H:%M:%S %Y") + offset
            except ValueError:
                new_lines.append(line)
                continue
            year = dt.year
            new_line = open_br + _fmt_dt(dt) + close_br + rest
            new_lines.append(new_line)
            changed += 1
            continue

        new_lines.append(line)

    if changed and not dry_run:
        path.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
    return changed


def collect_logs(root: Path) -> list[Path]:
    files: list[Path] = []
    seen: set[Path] = set()
    for f in sorted(root.glob("nwserverLog*.txt")):
        if f not in seen:
            files.append(f)
            seen.add(f)
    for sub in sorted(p for p in root.iterdir() if p.is_dir()):
        for f in sorted(sub.glob("nwserverLog*.txt")):
            if f not in seen:
                files.append(f)
                seen.add(f)
    return files


def main() -> int:
    args = sys.argv[1:]
    dry_run = "--dry-run" in args
    args = [a for a in args if a != "--dry-run"]

    if len(args) != 2:
        print(__doc__, file=sys.stderr)
        return 2

    root = Path(args[0]).expanduser().resolve()
    try:
        hours = int(args[1])
    except ValueError:
        print(f"error: offset-hours must be an integer, got: {args[1]!r}", file=sys.stderr)
        return 2

    if not root.is_dir():
        print(f"error: not a directory: {root}", file=sys.stderr)
        return 1

    offset = timedelta(hours=hours)
    logs = collect_logs(root)
    if not logs:
        print(f"No nwserverLog*.txt files found under {root}")
        return 0

    sign = "+" if hours >= 0 else ""
    label = f"UTC{sign}{hours}h"
    mode = "[dry-run] " if dry_run else ""
    print(f"{mode}Shifting {len(logs)} log file(s) by {hours:+d}h ({label}) under {root}")

    total_changed = 0
    for log_path in logs:
        n = shift_file(log_path, offset, dry_run)
        status = "would update" if dry_run else "updated"
        print(f"  {status} {log_path.relative_to(root)}  ({n} timestamps)")
        total_changed += n

    print(f"\n{mode}Done — {total_changed} timestamps {'would be ' if dry_run else ''}shifted.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
